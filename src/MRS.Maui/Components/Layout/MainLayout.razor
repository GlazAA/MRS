@inherits LayoutComponentBase
@using MRS.Maui.Services
@inject MauiAppStartupService Startup

<div class="mrs-shell">
    <main class="mrs-main">
        @Body
    </main>
    <EngineerSupportFab />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Startup.EnsureStartedAsync().ConfigureAwait(false);
    }
}
