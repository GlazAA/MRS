@using MRS.Application.Security
@using MRS.Application.Storage
@using MRS.Application.Sync
@using MRS.Maui.Services
@using Microsoft.Maui.Storage
@inject NavigationManager Nav
@inject ICurrentUserSession Session
@inject IServerSyncService ServerSync
@inject ILocalDatabaseBackupService DatabaseBackup
@inject IJSRuntime JS
@implements IDisposable

<button type="button" class="mrs-menu-button" @onclick="ToggleMenu" aria-label="Меню">
    ☰
</button>

@if (_showMenu)
{
    <div class="mrs-menu-panel">
        <button type="button"
                class="mrs-menu-item mrs-menu-sync"
                disabled="@(!MauiSyncDefaults.ServerSyncEnabled || _syncing)"
                title="@(_syncDisabledTitle)"
                @onclick="SyncAsync">
            <span class="mrs-menu-sync-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                    <circle cx="5" cy="12" r="2"/>
                    <circle cx="19" cy="6" r="2"/>
                    <circle cx="19" cy="18" r="2"/>
                    <path d="M7 11h8l2-4M7 13h8l2 4" stroke="currentColor" stroke-width="1.6" fill="none"/>
                </svg>
            </span>
            <span class="mrs-menu-sync-text">@_syncButtonLabel</span>
        </button>
        <button type="button" class="mrs-menu-item mrs-menu-item-util" disabled="@_backupBusy" @onclick="DownloadBackupAsync">Скачать резервную копию</button>
        <button type="button" class="mrs-menu-item mrs-menu-item-util" disabled="@_backupBusy" @onclick="RestoreBackupAsync">Импорт копии БД</button>
        @if (Session.IsDbAdministrator)
        {
            <button type="button" class="mrs-menu-item mrs-menu-item-util" @onclick="GoToSql">SQL-окно</button>
        }
        <div class="mrs-menu-divider" aria-hidden="true"></div>
        <button type="button" class="mrs-menu-item mrs-menu-item-nav" @onclick="GoToVisits">Календарь</button>
        <button type="button" class="mrs-menu-item mrs-menu-item-nav" @onclick="GoToNotes">Заметки</button>
        <button type="button" class="mrs-menu-item mrs-menu-item-nav" @onclick="GoToManagement">Управление листами</button>
        <button type="button" class="mrs-menu-item mrs-menu-item-nav" @onclick="GoToRegister">Внести объект / данные</button>
    </div>
}

@if (_showBackupMessage)
{
    <div class="mrs-modal-backdrop" @onclick="CloseBackupMessage">
        <div class="mrs-modal" @onclick:stopPropagation="true" style="max-width: 420px">
            <button type="button" class="mrs-modal-close" aria-label="Закрыть" @onclick="CloseBackupMessage">×</button>
            <h3 class="mrs-modal-title">@_backupTitle</h3>
            <p class="mrs-modal-body mrs-pre-wrap">@_backupMessage</p>
            <div class="mrs-form-actions" style="margin-top: 0">
                <button type="button" class="mrs-btn-primary" @onclick="CloseBackupMessage">Ок</button>
            </div>
        </div>
    </div>
}

@if (_showSyncResult && _syncResult is not null)
{
    <div class="mrs-modal-backdrop" @onclick="CloseSyncResult">
        <div class="mrs-modal" @onclick:stopPropagation="true" style="max-width: 420px">
            <button type="button" class="mrs-modal-close" aria-label="Закрыть" @onclick="CloseSyncResult">×</button>
            <h3 class="mrs-modal-title">@(_syncResult.Ok ? "Обновление выполнено" : "Обновление недоступно")</h3>
            <p class="mrs-modal-body mrs-pre-wrap">@_syncResult.Message</p>
            <div class="mrs-form-actions" style="margin-top: 0">
                <button type="button" class="mrs-btn-primary" @onclick="CloseSyncResult">Ок</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _showMenu;
    private bool _syncing;
    private bool _backupBusy;
    private bool _showSyncResult;
    private bool _showBackupMessage;
    private string _backupTitle = string.Empty;
    private string _backupMessage = string.Empty;
    private ServerSyncResult? _syncResult;

    private string _syncButtonLabel => !MauiSyncDefaults.ServerSyncEnabled
        ? "Обновить с сервера"
        : _syncing ? "Обновление…" : "Обновить с сервера";

    private string? _syncDisabledTitle => !MauiSyncDefaults.ServerSyncEnabled
        ? "Синхронизация временно отключена. Используйте обмен файлами .db."
        : null;

    protected override void OnInitialized()
    {
        ServerSync.Changed += OnSyncChanged;
    }

    private void OnSyncChanged() => InvokeAsync(StateHasChanged);

    private void ToggleMenu() => _showMenu = !_showMenu;

    private async Task SyncAsync()
    {
        if (!MauiSyncDefaults.ServerSyncEnabled)
            return;

        _showMenu = false;
        _syncing = true;
        try
        {
            _syncResult = await ServerSync.SyncAsync();
            _showSyncResult = true;
        }
        finally
        {
            _syncing = false;
        }
    }

    private void CloseSyncResult() => _showSyncResult = false;

    private void CloseBackupMessage() => _showBackupMessage = false;

    private async Task DownloadBackupAsync()
    {
        _showMenu = false;
        _backupBusy = true;
        try
        {
            var file = await DatabaseBackup.CreateBackupAsync().ConfigureAwait(false);
            var base64 = Convert.ToBase64String(file.Content);
            await JS.InvokeVoidAsync("mrsDownloadBase64File", file.FileName, "application/x-sqlite3", base64).ConfigureAwait(false);
            _backupTitle = "Копия сохранена";
            _backupMessage = $"Файл {file.FileName} скачан. Храните его в надёжном месте — это полная офлайн-база устройства.";
            _showBackupMessage = true;
        }
        catch (Exception ex)
        {
            _backupTitle = "Ошибка";
            _backupMessage = ex.Message;
            _showBackupMessage = true;
        }
        finally
        {
            _backupBusy = false;
        }
    }

    private async Task RestoreBackupAsync()
    {
        _showMenu = false;
        _backupBusy = true;
        try
        {
            var pick = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Выберите файл копии БД (.db)"
            }).ConfigureAwait(false);
            if (pick is null)
                return;

            await using var stream = await pick.OpenReadAsync().ConfigureAwait(false);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms).ConfigureAwait(false);
            await DatabaseBackup.RestoreFromBackupAsync(ms.ToArray()).ConfigureAwait(false);
            _backupTitle = "База импортирована";
            _backupMessage = "Локальная база заменена из файла. Перезапустите приложение, чтобы увидеть импортированные данные.";
            _showBackupMessage = true;
        }
        catch (Exception ex)
        {
            _backupTitle = "Ошибка восстановления";
            _backupMessage = ex.Message;
            _showBackupMessage = true;
        }
        finally
        {
            _backupBusy = false;
        }
    }

    private void GoToVisits()
    {
        _showMenu = false;
        Nav.NavigateTo("/objects/visits");
    }

    private void GoToNotes()
    {
        _showMenu = false;
        Nav.NavigateTo("/objects/comments");
    }

    private void GoToManagement()
    {
        _showMenu = false;
        Nav.NavigateTo("/management");
    }

    private void GoToRegister()
    {
        _showMenu = false;
        Nav.NavigateTo("/objects/register");
    }

    private void GoToSql()
    {
        _showMenu = false;
        Nav.NavigateTo("/sql");
    }

    public void Dispose() => ServerSync.Changed -= OnSyncChanged;
}
