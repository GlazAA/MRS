@page "/checklists/work/edit"
@using System.Globalization
@using MRS.Application.Admin
@using MRS.Application.Checklists
@using MRS.Application.Facilities
@using MRS.Application.Security
@inject IChecklistEditService ChecklistEdit
@inject IEquipmentModelCatalogService ModelCatalog
@inject IAdminSupportRequestService SupportRequests
@inject ICurrentUserSession Session
@inject NavigationManager Nav

<PageTitle>Изменить контрольный лист</PageTitle>

<div class="mrs-toolbar">
    <a class="mrs-back" href="/checklists/work">←</a>
    <h1 class="mrs-title">Изменить контрольный лист</h1>
    <MrsTopMenu />
</div>

@if (_loading && _model is null)
{
    <p>Загрузка…</p>
}
else if (_error is not null)
{
    <p class="text-danger">@_error</p>
}
else if (_model is null)
{
    <p>Не найден контрольный лист.</p>
}
else
{
    <div class="mrs-top-plate">
        Лист №@_model.Info.ChecklistId • @_model.Info.MaintenanceTypeName
    </div>

    <div class="mrs-info">
        <div style="margin-bottom: 0.35rem">
            Объект: <strong>@_model.Info.FacilityName</strong>
        </div>
        <div style="margin-bottom: 0.35rem">
            Заказчик: <strong>@_model.Info.OrganizationName</strong>
        </div>
        <div style="margin-bottom: 0.35rem">
            Оборудование: <strong>@_model.Info.EquipmentTypeName</strong>
        </div>
        <div>
            № установки: <strong>@_model.Info.InstallationLabel</strong>
        </div>
    </div>

    @if (_isEditing)
    {
        <div class="mrs-edit-banner">Режим редактирования — измените нужные поля и нажмите «Сохранить».</div>
    }
    else
    {
        <p class="mrs-hint" style="margin-top: 1rem">
            Лист открыт для просмотра. Чтобы изменить данные перед скачиванием, нажмите «Внести изменения».
        </p>
    }

    <div class="mrs-edit-fields" style="margin-top: 1rem">
        @foreach (var field in _model.Fields.Where(f => !ChecklistFieldCodes.IsHiddenOnFillForm(f.FieldCode)))
        {
            var disabled = _loading || _saving || !_isEditing || field.IsLocked;
            var wrapperClass = field.IsLocked ? "mrs-locked" : (!_isEditing ? "mrs-readonly" : null);

            <div class="mrs-field">
                <div class="@wrapperClass">
                    <label class="mrs-label">
                        @field.QuestionText@if (!field.IsLocked) { <text> *</text> }
                    </label>
                    @if (!string.IsNullOrWhiteSpace(field.HintText))
                    {
                        <p class="mrs-hint">@field.HintText</p>
                    }
                    @if (field.IsLocked)
                    {
                        <p class="mrs-hint mrs-lock-hint">@ChecklistEditFieldRules.GetLockReason(field.FieldCode)</p>
                    }

                    @if (EquipmentModelFieldCodes.IsManufacturerField(field.FieldCode))
                    {
                        <p class="mrs-field-hint">Начните вводить — выберите из списка или оставьте новое (необязательно).</p>
                        <EquipmentCatalogCombobox Value="@GetValue(field.TemplateItemId)"
                                                  ValueChanged="@(v => OnManufacturerValueAsync(field, v))"
                                                  Options="@GetManufacturersForField(field.FieldCode)"
                                                  Disabled="@disabled"
                                                  Placeholder="Производитель…" />
                    }
                    else if (EquipmentModelFieldCodes.IsModelField(field.FieldCode))
                    {
                        var selectedMfg = GetSelectedManufacturerForModelField(field);
                        <p class="mrs-field-hint">Сначала производитель, затем модель — из списка или новая.</p>
                        <EquipmentCatalogCombobox Value="@GetValue(field.TemplateItemId)"
                                                  ValueChanged="@(v => SetValue(field.TemplateItemId, v))"
                                                  Options="@GetCachedModelNames(field.FieldCode, selectedMfg)"
                                                  Disabled="@(disabled || string.IsNullOrWhiteSpace(selectedMfg))"
                                                  Placeholder="Модель…" />
                    }
                    else
                    {
                    @switch (field.FieldTypeName.ToLowerInvariant())
                    {
                        case "textarea":
                            <textarea class="mrs-select" rows="4" disabled="@disabled"
                                      value="@GetValue(field.TemplateItemId)"
                                      @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))"></textarea>
                            break;
                        case "date":
                            <input type="date" class="mrs-select" disabled="@disabled"
                                   value="@GetValue(field.TemplateItemId)"
                                   @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                            break;
                        case "time":
                            <input type="time" class="mrs-select" disabled="@disabled"
                                   value="@GetValue(field.TemplateItemId)"
                                   @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                            break;
                        case "number":
                            <input type="number" class="mrs-select" disabled="@disabled"
                                   value="@GetValue(field.TemplateItemId)"
                                   @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                            break;
                        case "boolean":
                            <select class="mrs-select" disabled="@disabled" value="@GetValue(field.TemplateItemId)"
                                    @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))">
                                <option value="">—</option>
                                <option value="false">Нет</option>
                                <option value="true">Да</option>
                            </select>
                            break;
                        case "radio":
                        case "dropdown":
                            @if (field.Options.Count > 0)
                            {
                                <select class="mrs-select" disabled="@disabled" value="@GetValue(field.TemplateItemId)"
                                        @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))">
                                    <option value="">—</option>
                                    @foreach (var opt in field.Options)
                                    {
                                        <option value="@opt.OptionId.ToString(CultureInfo.InvariantCulture)">@opt.Label</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" class="mrs-select" disabled="@disabled"
                                       value="@GetValue(field.TemplateItemId)"
                                       @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                            }
                            break;
                        case "checkbox":
                        case "dropdown_multiple":
                            <MultiSelectSearchPicker TemplateItemId="field.TemplateItemId"
                                                     Options="field.Options"
                                                     Value="@GetValue(field.TemplateItemId)"
                                                     ValueChanged="@(v => SetValue(field.TemplateItemId, v))"
                                                     AllowCreateEngineer="ChecklistFieldCodes.IsWorkers(field.FieldCode)"
                                                     Disabled="@disabled"
                                                     Placeholder="@(ChecklistFieldCodes.IsWorkers(field.FieldCode) ? "ФИО или фрагмент…" : "Поиск…")" />
                            break;
                        default:
                            <input type="text" class="mrs-select" disabled="@disabled"
                                   value="@GetValue(field.TemplateItemId)"
                                   @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                            break;
                    }
                    }
                </div>
            </div>
        }
    </div>

    <div class="mrs-sticky-actions">
        <div class="mrs-form-actions mrs-sticky-actions-inner">
            @if (!_isEditing)
            {
                <button type="button" class="mrs-btn-secondary" disabled="@(_loading || _saving)" @onclick="GoBack">Назад к списку</button>
                <button type="button" class="mrs-btn-primary" disabled="@(_loading || _saving || _model is null)" @onclick="EnableEditAsync">Внести изменения</button>
            }
            else
            {
                <button type="button" class="mrs-btn-secondary" disabled="@(_loading || _saving)" @onclick="CancelEditingAsync">Отменить</button>
                <button type="button" class="mrs-btn-primary" disabled="@(_loading || _saving)" @onclick="StartSave">
                    @(_saving ? "Сохранение…" : "Сохранить")
                </button>
            }
        </div>
    </div>
}

@* Conflict / partial save *@
@if (_showValidation && _model is not null && _dryRun is not null)
{
    <div class="mrs-modal-backdrop" @onclick="CloseValidation">
        <div class="mrs-modal" @onclick:stopPropagation="true" style="max-width: 560px">
            <button type="button" class="mrs-modal-close" aria-label="Закрыть" @onclick="CloseValidation">×</button>
            <h3 class="mrs-modal-title">@(_noChanges ? "Нет изменений" : "Не все изменения можно сохранить")</h3>
            <div class="mrs-modal-body">
                @if (_noChanges)
                {
                    <p style="margin-top: 0">Вы не изменили ни одного поля.</p>
                }
                else
                {
                    <p style="margin-top: 0; margin-bottom: 0.75rem">
                        Часть изменений сохранить нельзя — они могут нарушить целостность данных. Выберите действие ниже.
                    </p>
                    @if (_dryRun.CanSaveFields.Count > 0)
                    {
                        <div class="mrs-validate-section-title">Можно сохранить:</div>
                        <ul class="mrs-validate-list">
                            @foreach (var f in _dryRun.CanSaveFields)
                            {
                                <li class="mrs-validate-ok">@FormatFieldSummary(f)</li>
                            }
                        </ul>
                    }
                    @if (_dryRun.CannotSaveFields.Count > 0)
                    {
                        <div class="mrs-validate-section-title">Нельзя сохранить:</div>
                        <ul class="mrs-validate-list">
                            @foreach (var f in _dryRun.CannotSaveFields)
                            {
                                <li class="mrs-validate-blocked">
                                    <strong>@f.QuestionText</strong>
                                    @if (!string.IsNullOrWhiteSpace(f.AttemptedValue))
                                    {
                                        <span> → «@f.AttemptedValue»</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(f.Reason))
                                    {
                                        <div class="mrs-validate-reason">@f.Reason</div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
            <div class="mrs-form-actions mrs-validate-actions" style="margin-top: 0">
                @if (_noChanges)
                {
                    <button type="button" class="mrs-btn-primary" @onclick="CloseValidation">Ок</button>
                }
                else
                {
                    <button type="button" class="mrs-btn-secondary" disabled="@_saving" @onclick="RevertChangesAsync">Оставить без изменений</button>
                    @if (_dryRun.CanSaveFields.Count > 0)
                    {
                        <button type="button" class="mrs-btn-primary" disabled="@_saving" @onclick="SaveAllowedOnly">Сохранить допустимые</button>
                    }
                    @if (_dryRun.CannotSaveFields.Count > 0)
                    {
                        <button type="button" class="mrs-btn-equipment" disabled="@_saving" @onclick="SaveAllowedAndNotifyAdmin">
                            @(_dryRun.CanSaveFields.Count > 0 ? "Сохранить и сообщить администратору" : "Сообщить администратору")
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@* Success *@
@if (_showSuccess && _model is not null)
{
    <div class="mrs-modal-backdrop" @onclick="CloseSuccess">
        <div class="mrs-modal" @onclick:stopPropagation="true">
            <button type="button" class="mrs-modal-close" aria-label="Закрыть" @onclick="CloseSuccess">×</button>
            <h3 class="mrs-modal-title">Данные успешно изменены</h3>
            <p class="mrs-modal-body mrs-pre-wrap">
                @if (_adminNotified)
                {
                    <text>Допустимые изменения сохранены. Администратору отправлено обращение №@_adminRequestId с описанием конфликтующих полей.</text>
                }
                else
                {
                    <text>Контрольный лист обновлён. Можно вернуться к списку и скачать акт.</text>
                }
            </p>
            <div class="mrs-form-actions" style="margin-top: 0">
                <button type="button" class="mrs-btn-primary" @onclick="CloseSuccess">Ок</button>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "checklistId")]
    public int? ChecklistId { get; set; }

    private ChecklistEditModel? _model;
    private Dictionary<int, string> _values = [];
    private Dictionary<int, string> _originalValues = [];

    private bool _loading;
    private bool _saving;
    private string? _error;
    private int? _loadedChecklistId;
    private bool _isEditing;

    private bool _showValidation;
    private bool _showSuccess;
    private bool _noChanges;
    private bool _adminNotified;
    private int _adminRequestId;
    private ChecklistUpdateDryRunResult? _dryRun;

    private readonly Dictionary<int, List<string>> _manufacturersByEquipmentType = [];
    private readonly Dictionary<string, List<string>> _modelsByKey = new(StringComparer.OrdinalIgnoreCase);

    private static string FormatFieldSummary(ChecklistUpdateDryRunField field)
    {
        if (string.IsNullOrWhiteSpace(field.AttemptedValue))
            return field.QuestionText;
        return $"{field.QuestionText} → «{field.AttemptedValue}»";
    }

    private string GetValue(int templateItemId) =>
        _values.TryGetValue(templateItemId, out var v) ? v : string.Empty;

    private void SetValue(int templateItemId, string? value)
    {
        if (!_isEditing)
            return;

        _values[templateItemId] = value ?? string.Empty;
    }

    private async Task LoadCatalogsForTemplateAsync()
    {
        _manufacturersByEquipmentType.Clear();
        _modelsByKey.Clear();
        if (_model is null)
            return;

        var fallback = _model.Info.EquipmentTypeId;
        var typeIds = _model.Fields
            .Where(f => EquipmentModelFieldCodes.IsManufacturerField(f.FieldCode) || EquipmentModelFieldCodes.IsModelField(f.FieldCode))
            .Select(f => EquipmentModelFieldCodes.ResolveCatalogEquipmentTypeId(f.FieldCode, fallback))
            .Append(fallback)
            .Distinct()
            .ToList();

        foreach (var etId in typeIds)
        {
            _manufacturersByEquipmentType[etId] =
                (await ModelCatalog.GetManufacturersAsync(etId).ConfigureAwait(false)).ToList();
        }
    }

    private int ResolveFieldEquipmentTypeId(string? fieldCode)
    {
        var fallback = _model?.Info.EquipmentTypeId ?? 0;
        return EquipmentModelFieldCodes.ResolveCatalogEquipmentTypeId(fieldCode, fallback);
    }

    private IReadOnlyList<string> GetManufacturersForField(string? fieldCode)
    {
        var etId = ResolveFieldEquipmentTypeId(fieldCode);
        return _manufacturersByEquipmentType.TryGetValue(etId, out var list) ? list : [];
    }

    private async Task PrefetchModelOptionsAsync()
    {
        if (_model is null)
            return;

        foreach (var field in _model.Fields.Where(f => EquipmentModelFieldCodes.IsModelField(f.FieldCode)))
        {
            var manufacturer = GetSelectedManufacturerForModelField(field);
            if (!string.IsNullOrWhiteSpace(manufacturer))
                await EnsureModelsCachedAsync(field.FieldCode, manufacturer).ConfigureAwait(false);
        }
    }

    private async Task EnsureModelsCachedAsync(string? fieldCode, string manufacturer)
    {
        var etId = ResolveFieldEquipmentTypeId(fieldCode);
        var key = CacheKey(etId, manufacturer);
        if (key.Length == 0 || _modelsByKey.ContainsKey(key))
            return;

        var models = (await ModelCatalog.GetModelsAsync(etId, manufacturer).ConfigureAwait(false)).ToList();
        _modelsByKey[key] = models.Select(m => m.Name).ToList();
    }

    private IReadOnlyList<string> GetCachedModelNames(string? fieldCode, string? manufacturer)
    {
        if (string.IsNullOrWhiteSpace(manufacturer))
            return [];

        var etId = ResolveFieldEquipmentTypeId(fieldCode);
        var key = CacheKey(etId, manufacturer);
        return _modelsByKey.TryGetValue(key, out var models) ? models : [];
    }

    private static string CacheKey(int equipmentTypeId, string manufacturer) =>
        equipmentTypeId + "|" + manufacturer.Trim().ToLowerInvariant();

    private string? GetSelectedManufacturerForModelField(ChecklistEditField modelField)
    {
        if (_model is null)
            return null;

        var manufacturerCode = EquipmentModelFieldCodes.GetManufacturerFieldCode(modelField.FieldCode);
        if (manufacturerCode is null)
            return null;

        var manufacturerField = _model.Fields.FirstOrDefault(f =>
            string.Equals(f.FieldCode, manufacturerCode, StringComparison.OrdinalIgnoreCase));
        return manufacturerField is null ? null : GetValue(manufacturerField.TemplateItemId);
    }

    private async Task OnManufacturerValueAsync(ChecklistEditField field, string value)
    {
        if (!_isEditing)
            return;

        SetValue(field.TemplateItemId, value);

        var modelCode = EquipmentModelFieldCodes.GetModelFieldCode(field.FieldCode);
        if (modelCode is not null && _model is not null)
        {
            var modelField = _model.Fields.FirstOrDefault(f =>
                string.Equals(f.FieldCode, modelCode, StringComparison.OrdinalIgnoreCase));
            if (modelField is not null)
                SetValue(modelField.TemplateItemId, string.Empty);
        }

        if (!string.IsNullOrWhiteSpace(value))
            await EnsureModelsCachedAsync(field.FieldCode, value).ConfigureAwait(false);
    }

    private async Task PersistCatalogEntriesAsync()
    {
        if (_model is null)
            return;

        var fallbackEtId = _model.Info.EquipmentTypeId;
        foreach (var mfgField in _model.Fields.Where(f => EquipmentModelFieldCodes.IsManufacturerField(f.FieldCode)))
        {
            var mfg = GetValue(mfgField.TemplateItemId)?.Trim() ?? string.Empty;
            var modelCode = EquipmentModelFieldCodes.GetModelFieldCode(mfgField.FieldCode);
            var modelField = _model.Fields.FirstOrDefault(f =>
                string.Equals(f.FieldCode, modelCode, StringComparison.OrdinalIgnoreCase));
            var model = modelField is null ? string.Empty : (GetValue(modelField.TemplateItemId)?.Trim() ?? string.Empty);
            if (mfg.Length == 0)
                continue;

            var etId = EquipmentModelFieldCodes.ResolveCatalogEquipmentTypeId(mfgField.FieldCode, fallbackEtId);
            try
            {
                if (model.Length == 0)
                {
                    await ModelCatalog.EnsureManufacturerAsync(etId, mfg).ConfigureAwait(false);
                    continue;
                }

                var entry = await ModelCatalog.EnsureModelEntryAsync(etId, mfg, model).ConfigureAwait(false);
                SetValue(mfgField.TemplateItemId, entry.Manufacturer);
                if (modelField is not null)
                    SetValue(modelField.TemplateItemId, entry.Name);
            }
            catch
            {
            }
        }
    }

    private async Task LoadAsync(bool resetEditing = true)
    {
        if (ChecklistId is not int id)
        {
            if (ChecklistId is null)
                return;
            _error = "Не передан id контрольного листа.";
            return;
        }

        _loading = true;
        _saving = false;
        _error = null;
        _showValidation = false;
        _showSuccess = false;
        _noChanges = false;
        _adminNotified = false;
        _adminRequestId = 0;
        _dryRun = null;

        try
        {
            _model = await ChecklistEdit.GetForEditAsync(id);
            _values = _model.Fields.ToDictionary(f => f.TemplateItemId, f => f.ValueRaw);
            SyncEquipmentPickAnswerFromInfo();
            _originalValues = new Dictionary<int, string>(_values);
            _loadedChecklistId = id;
            await LoadCatalogsForTemplateAsync().ConfigureAwait(false);
            await PrefetchModelOptionsAsync().ConfigureAwait(false);
            if (resetEditing)
                _isEditing = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Скрытое поле equipment_pick — подставляем тип из карточки КЛ, если пусто.</summary>
    private void SyncEquipmentPickAnswerFromInfo()
    {
        if (_model is null)
            return;

        var field = _model.Fields.FirstOrDefault(f => ChecklistFieldCodes.IsEquipmentPick(f.FieldCode));
        if (field is null)
            return;

        if (_values.TryGetValue(field.TemplateItemId, out var existing) && !string.IsNullOrWhiteSpace(existing))
            return;

        var name = _model.Info.EquipmentTypeName;
        if (string.IsNullOrWhiteSpace(name))
            return;

        if (field.Options.Count > 0)
        {
            var match = field.Options.FirstOrDefault(o =>
                            string.Equals(o.Label, name, StringComparison.OrdinalIgnoreCase))
                        ?? field.Options.FirstOrDefault(o =>
                            o.Label.Contains(name, StringComparison.OrdinalIgnoreCase)
                            || name.Contains(o.Label, StringComparison.OrdinalIgnoreCase));
            if (match is not null)
            {
                _values[field.TemplateItemId] = match.OptionId.ToString(CultureInfo.InvariantCulture);
                return;
            }
        }

        _values[field.TemplateItemId] = name;
    }

    protected override async Task OnInitializedAsync()
    {
        await EnsureLoadedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await EnsureLoadedAsync();
    }

    private async Task EnsureLoadedAsync()
    {
        if (ChecklistId is not int id)
            return;

        if (_loadedChecklistId == id && _model is not null)
            return;

        await LoadAsync();
    }

    private void GoBack() => Nav.NavigateTo("/checklists/work");

    private Task EnableEditAsync()
    {
        if (_model is null)
            return Task.CompletedTask;

        _isEditing = true;
        _error = null;
        return InvokeAsync(StateHasChanged);
    }

    private Task CancelEditingAsync()
    {
        _values = new Dictionary<int, string>(_originalValues);
        _isEditing = false;
        _showValidation = false;
        _dryRun = null;
        _error = null;
        return InvokeAsync(StateHasChanged);
    }

    private async Task StartSave()
    {
        if (_model is null || !_isEditing)
            return;

        _showSuccess = false;
        _adminNotified = false;
        _adminRequestId = 0;
        _noChanges = false;
        _error = null;

        _saving = true;
        try
        {
            var request = new UpdateChecklistAnswersRequest(_model.Info.ChecklistId, _values);
            _dryRun = await ChecklistEdit.ValidateAsync(request);

            _noChanges = _dryRun.CanSaveFields.Count == 0 && _dryRun.CannotSaveFields.Count == 0;
            if (_noChanges)
            {
                _showValidation = true;
                return;
            }

            if (_dryRun.AllFieldsCanBeSaved)
            {
                await ApplyChangesAsync(
                    _dryRun.CanSaveFields.Select(f => f.TemplateItemId).ToList(),
                    notifyAdmin: false);
                return;
            }

            _showValidation = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ApplyChangesAsync(IReadOnlyList<int> templateItemIds, bool notifyAdmin)
    {
        if (_model is null || _dryRun is null)
            return;

        _saving = true;
        _error = null;
        try
        {
            if (templateItemIds.Count > 0)
            {
                await PersistCatalogEntriesAsync().ConfigureAwait(false);
                var request = new UpdateChecklistAnswersRequest(_model.Info.ChecklistId, _values);
                var apply = await ChecklistEdit.ApplyAsync(request, templateItemIds);
                if (!apply.Ok)
                    throw new InvalidOperationException(apply.ErrorMessage ?? "Ошибка сохранения изменений.");
            }

            if (notifyAdmin && _dryRun.CannotSaveFields.Count > 0)
            {
                var user = Session.Current;
                var body = ChecklistEditConflictReport.FormatForAdmin(
                    _model.Info,
                    user.DisplayName,
                    templateItemIds.Count > 0
                        ? _dryRun.CanSaveFields.Where(f => templateItemIds.Contains(f.TemplateItemId)).ToList()
                        : [],
                    _dryRun.CannotSaveFields);
                _adminRequestId = await SupportRequests.SubmitAsync(user.UserId, user.DisplayName, body);
                _adminNotified = true;
            }

            _isEditing = false;
            _showValidation = false;
            await LoadAsync(resetEditing: false);
            _showSuccess = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task SaveAllowedOnly() =>
        ApplyChangesAsync(_dryRun!.CanSaveFields.Select(f => f.TemplateItemId).ToList(), notifyAdmin: false);

    private Task SaveAllowedAndNotifyAdmin() =>
        ApplyChangesAsync(_dryRun!.CanSaveFields.Select(f => f.TemplateItemId).ToList(), notifyAdmin: true);

    private Task RevertChangesAsync()
    {
        _values = new Dictionary<int, string>(_originalValues);
        _isEditing = false;
        _showValidation = false;
        _dryRun = null;
        return InvokeAsync(StateHasChanged);
    }

    private void CloseValidation() => _showValidation = false;

    private void CloseSuccess() => _showSuccess = false;
}
