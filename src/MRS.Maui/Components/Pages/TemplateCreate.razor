@page "/templates/create"
@using System.Globalization
@using MRS.Application.Checklists
@using MRS.Application.Facilities
@using MRS.Maui.Services
@using Microsoft.Maui.ApplicationModel.DataTransfer
@inject IChecklistTemplateAuthoringService TemplateAuthoring
@inject IFacilityHierarchyService Hierarchy
@inject IUiFlashService Flash
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Создание шаблона ТО</PageTitle>

<div class="mrs-toolbar">
    <button type="button" class="mrs-back" @onclick="RequestLeaveToManagement" aria-label="Назад">←</button>
    <h1 class="mrs-title">Создание шаблона ТО</h1>
    <MrsTopMenu />
</div>

@if (_error is not null)
{
    <MrsErrorModal Message="@_error" OnClose="DismissError" />
}

<div class="mrs-object-form">
    <section class="mrs-field">
        <label class="mrs-label">Как создать?</label>
        <label class="mrs-check-label mrs-act-option">
            <input class="mrs-check" type="radio" name="template-mode" checked="@(_createMode == CreateMode.Blank)" @onchange="() => SetCreateMode(CreateMode.Blank)" />
            <span>С нуля</span>
        </label>
        <label class="mrs-check-label mrs-act-option">
            <input class="mrs-check" type="radio" name="template-mode" checked="@(_createMode == CreateMode.Analogy)" @onchange="() => SetCreateMode(CreateMode.Analogy)" />
            <span>По аналогии — скопировать поля из готового шаблона</span>
        </label>
    </section>

    @if (_createMode == CreateMode.Analogy)
    {
        <section class="mrs-field">
            <label class="mrs-label">Шаблон-образец *</label>
            <select class="mrs-select" value="@_cloneSourceId" @onchange="OnCloneSourceChanged">
                <option value="">— выберите —</option>
                @foreach (var src in _cloneSources)
                {
                    var scope = src.FacilityId is null
                        ? "общий"
                        : $"{src.OrganizationName} · {src.FacilityName}";
                    <option value="@src.TemplateId.ToString(CultureInfo.InvariantCulture)">
                        [@scope] @src.EquipmentTypeName · @src.MaintenanceTypeName — @src.TemplateName (@src.FieldCount полей)
                    </option>
                }
            </select>
            <div class="mrs-form-actions">
                <button type="button" class="mrs-btn-primary" disabled="@(_busy || string.IsNullOrEmpty(_cloneSourceId))" @onclick="ApplyCloneAsync">
                    Подставить поля
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(_cloneNotice))
            {
                <p class="mrs-save-msg">@_cloneNotice</p>
            }
        </section>
    }

    <div class="mrs-field @FieldClass(string.IsNullOrEmpty(_organizationChoice))">
        <label class="mrs-label">Клиент (компания) *</label>
        <select class="mrs-select" value="@_organizationChoice" @onchange="OnOrganizationChanged">
            <option value="">— выберите —</option>
            @foreach (var o in _organizations)
            {
                <option value="@o.Id.ToString(CultureInfo.InvariantCulture)">@o.Name</option>
            }
        </select>
    </div>

    <div class="mrs-field @FieldClass(string.IsNullOrEmpty(_facilityChoice))">
        <label class="mrs-label">Объект *</label>
        <select class="mrs-select" @bind="_facilityChoice" disabled="@(string.IsNullOrEmpty(_organizationChoice))">
            <option value="">— выберите —</option>
            @foreach (var f in _facilities)
            {
                <option value="@f.Id.ToString(CultureInfo.InvariantCulture)">@f.Name</option>
            }
        </select>
        <p class="mrs-hint-dashed">Шаблон сохраняется для этого объекта: на других площадках он не подставится автоматически.</p>
    </div>

    <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_templateName))">
        <label class="mrs-label">Название шаблона *</label>
        <input class="mrs-select" type="text" @bind="_templateName" @bind:event="oninput" placeholder="Например: Винтовой компрессор — ежегодное (Сахарово)" />
        <p class="mrs-hint-dashed">Можно оставить подставленное название или задать своё — так шаблон будет видно в списке видов ТО.</p>
    </div>

    <div class="mrs-field @FieldClass(string.IsNullOrEmpty(_equipmentTypeChoice))">
        <label class="mrs-label">Тип оборудования *</label>
        <select class="mrs-select" @bind="_equipmentTypeChoice">
            <option value="">— выберите —</option>
            @foreach (var et in _equipmentTypes)
            {
                <option value="@et.Id.ToString(CultureInfo.InvariantCulture)">@et.Name</option>
            }
        </select>
        <p class="mrs-hint-dashed">Куда привязать новый шаблон на выбранном объекте.</p>
    </div>

    <div class="mrs-field @FieldClass(string.IsNullOrEmpty(_maintenanceChoice))">
        <label class="mrs-label">Вид ТО *</label>
        <select class="mrs-select" @bind="_maintenanceChoice">
            <option value="">— выберите —</option>
            @foreach (var mt in _maintenanceTypes)
            {
                <option value="@mt.Id.ToString(CultureInfo.InvariantCulture)">@mt.Name</option>
            }
            <option value="new">+ Новый вид ТО</option>
        </select>
    </div>

    @if (_maintenanceChoice == "new")
    {
        <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_newMaintenanceName))">
            <label class="mrs-label">Название нового вида ТО *</label>
            <input class="mrs-select" type="text" @bind="_newMaintenanceName" @bind:event="oninput" />
            <p class="mrs-hint-dashed">@TemplateFieldTypeHints.NewMaintenanceNameHint</p>
        </div>
        <div class="mrs-field">
            <label class="mrs-label">Описание вида ТО</label>
            <textarea class="mrs-select" rows="3" @bind="_newMaintenanceDescription" @bind:event="oninput"></textarea>
            <p class="mrs-hint-dashed">@TemplateFieldTypeHints.MaintenanceTypeDescriptionHint</p>
        </div>
    }

    <details class="mrs-object-details" @ontoggle="OnTemplateDetailsToggle">
        <summary>Доп. параметры шаблона</summary>
        @if (_textSourceChoice is null)
        {
            <div class="mrs-field mrs-mt">
                <p class="mrs-hint">Использовать тексты по умолчанию для верхней плашки и кнопки «!»?</p>
                <div class="mrs-form-actions">
                    <button type="button" class="mrs-btn-primary" @onclick="ApplyDefaultTexts">Да, по умолчанию</button>
                    <button type="button" class="mrs-btn-secondary" @onclick="ChooseCustomTexts">Нет, задам сам</button>
                </div>
            </div>
        }
        else
        {
            <div class="mrs-field mrs-mt">
                <label class="mrs-label">Верхняя плашка</label>
                <p class="mrs-hint-dashed">@TemplateFieldTypeHints.TopPlateHint</p>
                @if (_textSourceChoice == TextSourceMode.Custom)
                {
                    <p class="mrs-hint">Нажмите строку, чтобы вставить текст. Удерживайте более 3 секунд — скопировать в буфер.</p>
                    <div class="mrs-text-preset-list">
                        @foreach (var preset in ChecklistTemplateTexts.TopPlatePresets)
                        {
                            <button type="button" class="mrs-text-preset-item"
                                    @onpointerdown="@(() => StartLongPress(preset))"
                                    @onpointerup="CancelLongPress"
                                    @onpointerleave="CancelLongPress"
                                    @onpointercancel="CancelLongPress"
                                    @onclick="@(() => InsertTopPlatePreset(preset))">
                                <span class="mrs-text-preset-label">@preset.Label</span>
                                <span class="mrs-text-preset-preview mrs-pre-wrap">@preset.Text</span>
                            </button>
                        }
                    </div>
                }
                <textarea class="mrs-select mrs-mt" rows="3" @bind="_topPlateText" @bind:event="oninput"></textarea>
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Текст кнопки «!» (безопасность)</label>
                <p class="mrs-hint-dashed">@TemplateFieldTypeHints.SafetyButtonHint</p>
                @if (_textSourceChoice == TextSourceMode.Custom)
                {
                    <p class="mrs-hint">Нажмите строку, чтобы вставить текст. Удерживайте более 3 секунд — скопировать в буфер.</p>
                    <div class="mrs-text-preset-list">
                        @foreach (var preset in ChecklistTemplateTexts.SafetyModalPresets)
                        {
                            <button type="button" class="mrs-text-preset-item"
                                    @onpointerdown="@(() => StartLongPress(preset))"
                                    @onpointerup="CancelLongPress"
                                    @onpointerleave="CancelLongPress"
                                    @onpointercancel="CancelLongPress"
                                    @onclick="@(() => InsertSafetyPreset(preset))">
                                <span class="mrs-text-preset-label">@preset.Label</span>
                                <span class="mrs-text-preset-preview mrs-pre-wrap">@preset.Text</span>
                            </button>
                        }
                    </div>
                }
                <textarea class="mrs-select mrs-mt" rows="6" @bind="_safetyModalText" @bind:event="oninput"></textarea>
            </div>
            <div class="mrs-field">
                <label class="mrs-check-label">
                    <input class="mrs-check" type="checkbox" @bind="_redButtonEnabled" />
                    Показать красную кнопку «!»
                </label>
            </div>
            @if (!string.IsNullOrWhiteSpace(_copyNotice))
            {
                <p class="mrs-info-note">@_copyNotice</p>
            }
        }
    </details>

    <p class="mrs-info-title">Поля шаблона (@KeptFieldCount)</p>
    @if (_createMode == CreateMode.Analogy && _fields.Count > 0)
    {
        <div class="mrs-form-actions mrs-mb">
            <button type="button" class="mrs-btn-secondary" @onclick="KeepAllFields">Оставить все</button>
            <button type="button" class="mrs-btn-secondary" @onclick="KeepOnlyCoreFields">Только каркас</button>
        </div>
    }

    @for (var i = 0; i < _fields.Count; i++)
    {
        var field = _fields[i];
        var index = i;
        <div class="mrs-template-field-card @(field.Keep ? null : "mrs-template-field-card-off")">
            <div class="mrs-template-field-header">
                @if (_createMode == CreateMode.Analogy)
                {
                    <label class="mrs-check-label">
                        <input class="mrs-check" type="checkbox" @bind="field.Keep" />
                        <span>Поле #@(index + 1)</span>
                    </label>
                }
                else
                {
                    <span>Поле #@(index + 1)</span>
                }
                <div class="mrs-template-field-actions">
                    @if (_createMode == CreateMode.Analogy)
                    {
                        <button type="button" class="mrs-btn-secondary mrs-btn-compact" @onclick="() => ToggleFieldExpanded(index)">
                            @(field.Expanded ? "Свернуть" : "Изменить")
                        </button>
                    }
                    <button type="button" class="mrs-btn-small-danger" @onclick="() => RemoveField(index)">Удалить</button>
                </div>
            </div>

            @if (_createMode == CreateMode.Analogy && !field.Expanded)
            {
                <p class="mrs-template-field-summary">
                    <strong>@field.QuestionText</strong>
                    <span class="mrs-info-note"> · @TemplateFieldTypeHints.GetFieldTypeLabel(field.FieldTypeName)</span>
                </p>
            }
            else
            {
            <div class="mrs-field">
                <label class="mrs-label">Текст вопроса *</label>
                <input class="mrs-select" type="text" @bind="field.QuestionText" @bind:event="oninput" @bind:after="() => OnQuestionTextChanged(index)" />
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Подсказка для инженера</label>
                <input class="mrs-select" type="text" @bind="field.HintText" @bind:event="oninput" />
                <p class="mrs-hint-dashed">Серый текст под полем при заполнении контрольного листа (не путать с подсказками здесь, при создании шаблона).</p>
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Тип поля *</label>
                <select class="mrs-select" @bind="field.FieldTypeName">
                    @foreach (var t in TemplateFieldTypeHints.AuthoringFieldTypes)
                    {
                        <option value="@t">@TemplateFieldTypeHints.GetFieldTypeLabel(t)</option>
                    }
                </select>
                @if (TemplateFieldTypeHints.GetForFieldType(field.FieldTypeName) is { } typeHint)
                {
                    <p class="mrs-hint-dashed">@typeHint</p>
                }
            </div>
            <div class="mrs-field">
                <label class="mrs-check-label">
                    <input class="mrs-check" type="checkbox" @bind="field.IsRequired" />
                    Обязательное поле
                </label>
            </div>

            @if (TemplateFieldTypeHints.FieldTypeNeedsOptions(field.FieldTypeName))
            {
                <div class="mrs-field">
                    <label class="mrs-label">Варианты ответа</label>
                    <textarea class="mrs-select" rows="4" @bind="field.OptionsRaw" @bind:event="oninput"></textarea>
                    <p class="mrs-hint-dashed">@TemplateFieldTypeHints.FieldOptionsHint</p>
                </div>
            }
            }
        </div>
    }

    <div class="mrs-form-actions">
        <button type="button" class="mrs-btn-secondary" @onclick="AddField">+ Добавить поле</button>
        <button type="button" class="mrs-btn-primary" @onclick="SaveTemplateAsync" disabled="@_busy">Сохранить шаблон</button>
    </div>
</div>

@if (_showLeaveConfirm)
{
    <div class="mrs-modal-backdrop" @onclick="CancelLeave">
        <div class="mrs-modal" @onclick:stopPropagation="true" style="max-width: 420px">
            <h3 class="mrs-modal-title">Выйти без сохранения?</h3>
            <p class="mrs-modal-body">Данные шаблона ещё не сохранены и будут потеряны.</p>
            <div class="mrs-form-actions" style="margin-top: 0">
                <button type="button" class="mrs-btn-secondary" @onclick="CancelLeave">Остаться</button>
                <button type="button" class="mrs-btn-primary" @onclick="ConfirmLeave">Выйти</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly List<HierarchyOption> _organizations = [];
    private readonly List<HierarchyOption> _facilities = [];
    private readonly List<HierarchyOption> _equipmentTypes = [];
    private readonly List<MaintenanceTypeOption> _maintenanceTypes = [];
    private readonly List<TemplateCloneSourceOption> _cloneSources = [];
    private readonly List<FieldDraft> _fields = [];

    private bool _busy;
    private string? _error;
    private CreateMode _createMode = CreateMode.Blank;
    private string _cloneSourceId = string.Empty;
    private string? _cloneNotice;
    private bool _showLeaveConfirm;
    private bool _allowLeave;
    private string? _pendingNavigateUri;
    private IDisposable? _locationChangingRegistration;

    private string _organizationChoice = string.Empty;
    private string _facilityChoice = string.Empty;
    private string _equipmentTypeChoice = string.Empty;
    private string _maintenanceChoice = string.Empty;
    private string _newMaintenanceName = string.Empty;
    private string _newMaintenanceCode = string.Empty;
    private string _newMaintenanceDescription = string.Empty;
    private string _templateName = string.Empty;
    private string _scenarioCode = string.Empty;
    private string _topPlateText = string.Empty;
    private string _safetyModalText = string.Empty;
    private bool _redButtonEnabled;
    private TextSourceMode? _textSourceChoice;
    private string? _copyNotice;
    private Timer? _longPressTimer;
    private ChecklistTemplateTextPreset? _longPressPreset;
    private bool _longPressTriggered;

    private enum TextSourceMode { Default, Custom }
    private enum CreateMode { Blank, Analogy }

    private int KeptFieldCount => _fields.Count(f => f.Keep);
    private bool _highlightMissing;

    private string? FieldClass(bool isEmpty) =>
        _highlightMissing && isEmpty ? "mrs-field-invalid" : null;

    private void DismissError()
    {
        _error = null;
    }

    private void ShowError(string message)
    {
        _error = message;
        _highlightMissing = true;
    }

    protected override void OnInitialized()
    {
        _locationChangingRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
    }

    private ValueTask OnLocationChangingAsync(LocationChangingContext context)
    {
        if (_allowLeave || !HasUnsavedDraft())
            return ValueTask.CompletedTask;

        // Тот же URI — не блокируем.
        if (IsSamePageNavigation(context.TargetLocation))
            return ValueTask.CompletedTask;

        context.PreventNavigation();
        _pendingNavigateUri = context.TargetLocation;
        _showLeaveConfirm = true;
        _ = InvokeAsync(StateHasChanged);
        return ValueTask.CompletedTask;
    }

    private bool IsSamePageNavigation(string targetLocation)
    {
        var current = Nav.ToBaseRelativePath(Nav.Uri);
        var target = Nav.ToBaseRelativePath(targetLocation);
        return string.Equals(current, target, StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>Есть ли черновик, который жалко потерять при уходе.</summary>
    private bool HasUnsavedDraft()
    {
        if (!string.IsNullOrWhiteSpace(_templateName))
            return true;
        if (!string.IsNullOrEmpty(_organizationChoice) || !string.IsNullOrEmpty(_facilityChoice))
            return true;
        if (!string.IsNullOrEmpty(_equipmentTypeChoice) || !string.IsNullOrEmpty(_maintenanceChoice))
            return true;
        if (_createMode == CreateMode.Analogy && (!string.IsNullOrEmpty(_cloneSourceId) || _fields.Count > 0))
            return true;
        if (_fields.Any(f => f.Keep && (!string.IsNullOrWhiteSpace(f.QuestionText) || !string.IsNullOrWhiteSpace(f.HintText))))
            return true;
        if (_textSourceChoice is not null || _redButtonEnabled)
            return true;
        if (!string.IsNullOrWhiteSpace(_topPlateText) || !string.IsNullOrWhiteSpace(_safetyModalText) || !string.IsNullOrWhiteSpace(_scenarioCode))
            return true;
        return false;
    }

    private void RequestLeaveToManagement() => Nav.NavigateTo("/management");

    private void CancelLeave()
    {
        _showLeaveConfirm = false;
        _pendingNavigateUri = null;
    }

    private void ConfirmLeave()
    {
        var target = _pendingNavigateUri ?? "/management";
        _showLeaveConfirm = false;
        _pendingNavigateUri = null;
        _allowLeave = true;
        Nav.NavigateTo(target);
    }

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _organizations.AddRange(await Hierarchy.GetOrganizationsAsync().ConfigureAwait(false));
            _equipmentTypes.AddRange(await TemplateAuthoring.GetEquipmentTypesAsync().ConfigureAwait(false));
            _maintenanceTypes.AddRange(await TemplateAuthoring.GetMaintenanceTypesAsync().ConfigureAwait(false));
            _cloneSources.AddRange(await TemplateAuthoring.ListTemplatesForCloneAsync().ConfigureAwait(false));
            AddField();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnOrganizationChanged(ChangeEventArgs e)
    {
        _organizationChoice = e.Value?.ToString() ?? string.Empty;
        _facilityChoice = string.Empty;
        _facilities.Clear();
        if (int.TryParse(_organizationChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var orgId) && orgId > 0)
        {
            try
            {
                _facilities.AddRange(await Hierarchy.GetFacilitiesWithAddressAsync(orgId).ConfigureAwait(false));
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
        }
    }

    private void SetCreateMode(CreateMode mode)
    {
        if (_createMode == mode)
            return;

        _createMode = mode;
        _cloneNotice = null;
        _error = null;
        _fields.Clear();
        if (mode == CreateMode.Blank)
        {
            _cloneSourceId = string.Empty;
            AddField();
        }
    }

    private void OnCloneSourceChanged(ChangeEventArgs e)
    {
        _cloneSourceId = e.Value?.ToString() ?? string.Empty;
        _cloneNotice = null;
    }

    private async Task ApplyCloneAsync()
    {
        _error = null;
        _cloneNotice = null;
        _busy = true;
        try
        {
            if (!int.TryParse(_cloneSourceId, NumberStyles.Integer, CultureInfo.InvariantCulture, out var templateId))
                throw new InvalidOperationException("Выберите шаблон-образец.");

            var draft = await TemplateAuthoring.GetTemplateCloneDraftAsync(templateId).ConfigureAwait(false);

            if (draft.OrganizationId is int orgId && orgId > 0)
            {
                _organizationChoice = orgId.ToString(CultureInfo.InvariantCulture);
                _facilities.Clear();
                _facilities.AddRange(await Hierarchy.GetFacilitiesWithAddressAsync(orgId).ConfigureAwait(false));
            }

            if (draft.FacilityId is int fid && fid > 0)
                _facilityChoice = fid.ToString(CultureInfo.InvariantCulture);

            _equipmentTypeChoice = draft.EquipmentTypeId.ToString(CultureInfo.InvariantCulture);
            _maintenanceChoice = draft.MaintenanceTypeId.ToString(CultureInfo.InvariantCulture);
            _templateName = string.IsNullOrWhiteSpace(draft.TemplateName)
                ? "Новый шаблон"
                : $"{draft.TemplateName} (копия)";
            _scenarioCode = string.Empty;

            if (!string.IsNullOrWhiteSpace(draft.TopPlateText) || !string.IsNullOrWhiteSpace(draft.SafetyModalText))
            {
                _textSourceChoice = TextSourceMode.Custom;
                _topPlateText = draft.TopPlateText ?? string.Empty;
                _safetyModalText = draft.SafetyModalText ?? string.Empty;
                _redButtonEnabled = draft.RedButtonEnabled;
            }

            _fields.Clear();
            foreach (var f in draft.Fields)
            {
                _fields.Add(new FieldDraft
                {
                    FieldCode = f.FieldCode ?? string.Empty,
                    FieldCodeManual = !string.IsNullOrWhiteSpace(f.FieldCode),
                    QuestionText = f.QuestionText,
                    HintText = f.HintText ?? string.Empty,
                    FieldTypeName = f.FieldTypeName,
                    IsRequired = f.IsRequired,
                    OptionsRaw = string.Join('\n', f.Options),
                    Keep = true,
                    Expanded = false
                });
            }

            _cloneNotice = draft.FacilityId is null
                ? $"Подставлено {draft.Fields.Count} полей из «{draft.TemplateName}» (общий шаблон). Выберите объект для нового шаблона."
                : $"Подставлено {draft.Fields.Count} полей из «{draft.TemplateName}». При необходимости смените объект.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void KeepAllFields()
    {
        foreach (var f in _fields)
            f.Keep = true;
    }

    private void KeepOnlyCoreFields()
    {
        foreach (var f in _fields)
        {
            f.Keep = ChecklistWorkSessionFieldCodes.IsTimingField(f.FieldCode)
                     || ChecklistFieldCodes.IsWorkers(f.FieldCode);
        }
    }

    private void ToggleFieldExpanded(int index)
    {
        if (index < 0 || index >= _fields.Count)
            return;
        _fields[index].Expanded = !_fields[index].Expanded;
    }

    private void AddField()
    {
        _fields.Add(new FieldDraft
        {
            FieldTypeName = "text",
            Keep = true,
            Expanded = true
        });
        SyncAllFieldCodes();
    }

    private void OnQuestionTextChanged(int index)
    {
        if (index < 0 || index >= _fields.Count)
            return;
        _fields[index].FieldCodeManual = false;
        SyncFieldCode(index);
    }

    private void SyncFieldCode(int index)
    {
        if (index < 0 || index >= _fields.Count)
            return;

        var field = _fields[index];
        var used = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        for (var i = 0; i < _fields.Count; i++)
        {
            if (i == index)
                continue;
            if (!string.IsNullOrWhiteSpace(_fields[i].FieldCode))
                used.Add(_fields[i].FieldCode);
        }

        field.FieldCode = TemplateFieldCodeGenerator.SuggestFromQuestion(field.QuestionText, used);
        field.FieldCodeManual = false;
    }

    private void SyncAllFieldCodes()
    {
        var used = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var field in _fields)
        {
            if (!field.Keep)
                continue;

            if (field.FieldCodeManual && !string.IsNullOrWhiteSpace(field.FieldCode))
            {
                used.Add(field.FieldCode);
                continue;
            }

            field.FieldCode = TemplateFieldCodeGenerator.SuggestFromQuestion(field.QuestionText, used);
            field.FieldCodeManual = false;
            if (!string.IsNullOrWhiteSpace(field.FieldCode))
                used.Add(field.FieldCode);
        }
    }

    private void EnsureMaintenanceAndScenarioCodes(int equipmentTypeId)
    {
        if (_maintenanceChoice == "new")
            _newMaintenanceCode = TemplateFieldCodeGenerator.SuggestMaintenanceTypeCode(_newMaintenanceName);

        if (string.IsNullOrWhiteSpace(_scenarioCode))
            _scenarioCode = TemplateFieldCodeGenerator.SuggestScenarioCode(_templateName, equipmentTypeId);
    }

    private void RemoveField(int index)
    {
        if (index < 0 || index >= _fields.Count)
            return;
        _fields.RemoveAt(index);
        if (_fields.Count == 0)
            AddField();
    }

    private void OnTemplateDetailsToggle() { }

    private void ApplyDefaultTexts()
    {
        _textSourceChoice = TextSourceMode.Default;
        _topPlateText = ChecklistTemplateTexts.DefaultTopPlateText;
        _safetyModalText = ChecklistTemplateTexts.DefaultSafetyModalText;
        _redButtonEnabled = true;
    }

    private void ChooseCustomTexts()
    {
        _textSourceChoice = TextSourceMode.Custom;
        _redButtonEnabled = true;
    }

    private void InsertTopPlatePreset(ChecklistTemplateTextPreset preset)
    {
        if (_longPressTriggered)
            return;
        _topPlateText = preset.Text;
    }

    private void InsertSafetyPreset(ChecklistTemplateTextPreset preset)
    {
        if (_longPressTriggered)
            return;
        _safetyModalText = preset.Text;
        _redButtonEnabled = true;
    }

    private void StartLongPress(ChecklistTemplateTextPreset preset)
    {
        _longPressPreset = preset;
        _longPressTriggered = false;
        _longPressTimer?.Dispose();
        _longPressTimer = new Timer(_ =>
        {
            _ = InvokeAsync(async () =>
            {
                _longPressTriggered = true;
                await Clipboard.Default.SetTextAsync(preset.Text).ConfigureAwait(false);
                _copyNotice = $"Скопировано: {preset.Label}";
                StateHasChanged();
            });
        }, null, 3000, Timeout.Infinite);
    }

    private void CancelLongPress()
    {
        _longPressTimer?.Dispose();
        _longPressTimer = null;
    }

    private void EnsureTemplateTextsBeforeSave()
    {
        if (_textSourceChoice is null)
            ApplyDefaultTexts();

        if (string.IsNullOrWhiteSpace(_topPlateText))
            _topPlateText = ChecklistTemplateTexts.DefaultTopPlateText;

        if (_redButtonEnabled && string.IsNullOrWhiteSpace(_safetyModalText))
            _safetyModalText = ChecklistTemplateTexts.DefaultSafetyModalText;
    }

    private async Task SaveTemplateAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            if (!int.TryParse(_organizationChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
            {
                ShowError("Выберите клиента (компанию).");
                return;
            }

            if (!int.TryParse(_facilityChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var facilityId))
            {
                ShowError("Выберите объект — шаблон привязывается к объекту компании.");
                return;
            }

            if (string.IsNullOrWhiteSpace(_templateName))
            {
                ShowError("Укажите название нового шаблона.");
                return;
            }

            if (!int.TryParse(_equipmentTypeChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var equipmentTypeId))
            {
                ShowError("Выберите тип оборудования.");
                return;
            }

            int? existingMaintenanceTypeId = null;
            if (_maintenanceChoice != "new")
            {
                if (!int.TryParse(_maintenanceChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var mtid))
                {
                    ShowError("Выберите вид ТО или создайте новый.");
                    return;
                }
                existingMaintenanceTypeId = mtid;
            }

            EnsureTemplateTextsBeforeSave();
            SyncAllFieldCodes();
            EnsureMaintenanceAndScenarioCodes(equipmentTypeId);

            var kept = _fields.Where(f => f.Keep).ToList();
            if (kept.Count == 0)
            {
                ShowError("Оставьте хотя бы одно поле шаблона.");
                return;
            }

            var fieldRequests = new List<CreateTemplateFieldRequest>(kept.Count);
            var sortOrder = 0;
            foreach (var f in kept)
            {
                if (ChecklistFieldCodes.IsEndTime(f.FieldCode))
                {
                    ShowError("Поле «Время окончания» (end_time) больше не используется — удалите его из шаблона.");
                    return;
                }

                sortOrder++;
                fieldRequests.Add(new CreateTemplateFieldRequest(
                    SortOrder: sortOrder,
                    FieldCode: f.FieldCode,
                    QuestionText: f.QuestionText,
                    HintText: f.HintText,
                    FieldTypeName: f.FieldTypeName,
                    IsRequired: f.IsRequired,
                    GroupName: null,
                    ValidationRuleCode: null,
                    Options: SplitOptions(f.OptionsRaw)));
            }

            var request = new CreateChecklistTemplateRequest(
                FacilityId: facilityId,
                EquipmentTypeId: equipmentTypeId,
                ExistingMaintenanceTypeId: existingMaintenanceTypeId,
                NewMaintenanceTypeName: _maintenanceChoice == "new" ? _newMaintenanceName : null,
                NewMaintenanceTypeCode: _maintenanceChoice == "new" ? _newMaintenanceCode : null,
                NewMaintenanceTypeDescription: _maintenanceChoice == "new" ? _newMaintenanceDescription : null,
                TemplateName: _templateName,
                ScenarioCode: _scenarioCode,
                TopPlateText: _topPlateText,
                IntroModalText: null,
                SafetyModalText: _safetyModalText,
                RedButtonEnabled: _redButtonEnabled,
                Fields: fieldRequests);

            var newTemplateId = await TemplateAuthoring.CreateTemplateAsync(request).ConfigureAwait(false);
            var title = _templateName.Trim();
            var facilityName = _facilities.FirstOrDefault(x => x.Id == facilityId)?.Name ?? $"объект #{facilityId}";
            var equipmentName = _equipmentTypes.FirstOrDefault(x => x.Id == equipmentTypeId)?.Name ?? $"тип #{equipmentTypeId}";
            Flash.Set(
                $"Шаблон «{title}» сохранён для «{facilityName}» (ID: {newTemplateId}). " +
                $"В контрольных листах: этот объект → {equipmentName} → нужный вид ТО (подпись «для этого объекта»).");
            _allowLeave = true;
            Nav.NavigateTo("/management");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private static IReadOnlyList<string> SplitOptions(string? optionsRaw)
    {
        if (string.IsNullOrWhiteSpace(optionsRaw))
            return [];
        return optionsRaw
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => x.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    public void Dispose()
    {
        _locationChangingRegistration?.Dispose();
        _longPressTimer?.Dispose();
    }

    private sealed class FieldDraft
    {
        public string FieldCode { get; set; } = string.Empty;
        public bool FieldCodeManual { get; set; }
        public string QuestionText { get; set; } = string.Empty;
        public string HintText { get; set; } = string.Empty;
        public string FieldTypeName { get; set; } = "text";
        public bool IsRequired { get; set; }
        public string OptionsRaw { get; set; } = string.Empty;
        public bool Keep { get; set; } = true;
        public bool Expanded { get; set; }
    }
}
