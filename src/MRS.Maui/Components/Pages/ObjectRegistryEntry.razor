@page "/objects/register"
@using System.Globalization
@using MRS.Application.Checklists
@using MRS.Application.Facilities
@inject IFacilityHierarchyService Hierarchy
@inject IObjectOnboardingService Onboarding
@inject IEquipmentModelCatalogService ModelCatalog

<PageTitle>Внесение данных по объекту</PageTitle>

<div class="mrs-toolbar">
    <a class="mrs-back" href="/objects">←</a>
    <h1 class="mrs-title">Внесение данных по объекту</h1>
    <MrsTopMenu />
</div>

@if (_saved is not null)
{
    <div class="mrs-flash-banner" role="status">@_saved</div>
}

<MrsErrorModal Message="@_error" OnClose="DismissError" />

<div class="mrs-object-form">
    <div class="mrs-field @FieldClass(IsOrgMissing)">
        <label class="mrs-label">Организация *</label>
        <div class="mrs-combobox">
            <input class="mrs-select"
                   type="text"
                   placeholder="Начните вводить название…"
                   value="@_orgSearchText"
                   @oninput="OnOrgSearchInput"
                   @onfocus="OnOrgSearchFocus"
                   @onblur="OnOrgSearchBlur"
                   disabled="@_busy"
                   autocomplete="off" />
            @if (_orgDropdownOpen)
            {
                <ul class="mrs-combobox-list" @onmousedown:preventDefault="true">
                    @foreach (var o in FilteredOrganizations)
                    {
                        <li class="mrs-combobox-item" @onclick="() => SelectOrganizationAsync(o)">@o.Name</li>
                    }
                    @if (!FilteredOrganizations.Any() && !string.IsNullOrWhiteSpace(_orgSearchText))
                    {
                        <li class="mrs-combobox-empty">Совпадений нет</li>
                    }
                    <li class="mrs-combobox-item mrs-combobox-item-new" @onclick="SelectNewOrganization">+ Новая организация</li>
                </ul>
            }
        </div>
        @if (_orgChoice == "new")
        {
            <p class="mrs-field-hint">
                Название без юр. статуса и кавычек (например «Пилот»).
                В списках КЛ — просто «Пилот»; в акте Word/PDF — полное: «Закрытое акционерное общество Пилот».
            </p>
        }
        else if (string.IsNullOrWhiteSpace(_orgChoice))
        {
            <p class="mrs-field-hint">Выберите существующую или «+ Новая организация».</p>
        }
    </div>

    @if (_orgChoice == "new")
    {
        <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_newOrgLegalForm))">
            <label class="mrs-label">Юридический статус *</label>
            <select class="mrs-select" @bind="_newOrgLegalForm" disabled="@_busy">
                <option value="">— выберите —</option>
                @foreach (var form in OrganizationLegalForm.Choices)
                {
                    <option value="@form.Code">@form.ShortLabel</option>
                }
            </select>
            <p class="mrs-field-hint">Нужен для акта. В приложении к названию не приписывается.</p>
        </div>
    }

    <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_facilityChoice))">
        <label class="mrs-label">Объект *</label>
        <select class="mrs-select" value="@_facilityChoice" @onchange="OnFacilityChoiceChanged" disabled="@(_busy || !IsOrgChosen)">
            <option value="">— выберите —</option>
            @foreach (var f in _facilities)
            {
                <option value="@f.Id.ToString(CultureInfo.InvariantCulture)">@f.Name</option>
            }
            <option value="new">+ Новый объект</option>
        </select>
    </div>

    @if (_facilityChoice == "new")
    {
        <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_newFacilityName))">
            <label class="mrs-label">Краткое название объекта *</label>
            <input class="mrs-select" type="text" @bind="_newFacilityName" @bind:event="oninput" disabled="@_busy"
                   placeholder="Например: Склад №3, ТРЦ «Авиапарк», Цех 2" />
            <p class="mrs-field-hint">
                Как объект будет называться в списках приложения (контрольные листы, сборка акта, организации).
                Не путать с адресом ниже: в самом акте Word/PDF в строке «Объект» обычно печатается адрес
                (город, улица, дом). Это название — короткий ярлык площадки внутри компании.
                Примеры: «Склад №3», «Производство, корп. Б», «ТРЦ Авиапарк». Без кавычек и без юр. формы.
            </p>
        </div>

        <div class="mrs-field">
            <label class="mrs-label">Адрес объекта по договору</label>
            <input class="mrs-select" type="text" @bind="_contractAddress" @bind:event="oninput" disabled="@_busy" />
        </div>

        <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_city))">
            <label class="mrs-label">Город *</label>
            <input class="mrs-select" type="text" @bind="_city" @bind:event="oninput" disabled="@_busy" />
        </div>

        <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_street))">
            <label class="mrs-label">Улица *</label>
            <input class="mrs-select" type="text" @bind="_street" @bind:event="oninput" disabled="@_busy" />
        </div>

        <p class="mrs-address-hint">Реальный адрес объекта</p>
        <div class="mrs-address-row">
            <div class="mrs-field">
                <label class="mrs-label">Индекс</label>
                <input class="mrs-select" type="text" @bind="_zip" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(_building))">
                <label class="mrs-label">Дом *</label>
                <input class="mrs-select" type="text" @bind="_building" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Строение</label>
                <input class="mrs-select" type="text" @bind="_structure" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Корпус</label>
                <input class="mrs-select" type="text" @bind="_block" @bind:event="oninput" disabled="@_busy" />
            </div>
        </div>
    }

    @if (IsFacilityChosen)
    {
        <div class="mrs-field">
            <label class="mrs-label">Описание системы</label>
            <textarea class="mrs-select" rows="3" @bind="_systemDescription" @bind:event="oninput" disabled="@_busy"></textarea>
            <p class="mrs-field-hint">
                Внутренние заметки — в акты и документы не попадают.
                Имеет смысл указать: сколько установок на объекте; какие расходники обычно нужны, в каком количестве и за какой срок их заказывать.
            </p>
        </div>

        <h2 class="mrs-section-title">Установки / оборудование</h2>
        @for (var i = 0; i < _installations.Count; i++)
        {
            var index = i;
            var item = _installations[index];
            <div class="mrs-template-field-card">
                <div class="mrs-template-field-header">
                    <span>Установка @(index + 1)</span>
                    @if (_installations.Count > 1)
                    {
                        <button type="button" class="mrs-btn-small-danger" @onclick="() => RemoveInstallation(index)" disabled="@_busy">Удалить</button>
                    }
                </div>

                <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(item.EquipmentChoice))">
                    <label class="mrs-label">Тип оборудования *</label>
                    <select class="mrs-select" value="@item.EquipmentChoice" @onchange="e => OnEquipmentChoiceChanged(index, e)" disabled="@_busy">
                        <option value="">— выберите —</option>
                        @foreach (var et in _equipmentTypes)
                        {
                            <option value="@et.Id.ToString(CultureInfo.InvariantCulture)">@et.Name</option>
                        }
                        <option value="new">+ Новый тип оборудования</option>
                    </select>
                </div>

                @if (item.EquipmentChoice == "new")
                {
                    <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(item.NewEquipmentTypeName))">
                        <label class="mrs-label">Название типа оборудования *</label>
                        <input class="mrs-select" type="text"
                               @bind="item.NewEquipmentTypeName"
                               @bind:event="oninput"
                               @bind:after="() => LoadEquipmentCatalogAsync(index)"
                               disabled="@_busy" />
                    </div>
                }

                <div class="mrs-field">
                    <label class="mrs-label">Серийный номер</label>
                    <input class="mrs-select" type="text" @bind="item.Serial" @bind:event="oninput" disabled="@_busy" />
                </div>

                <details class="mrs-object-details">
                    <summary>Дополнительно по установке</summary>
                    <div class="mrs-field mrs-mt">
                        <label class="mrs-label">Производитель</label>
                        <p class="mrs-field-hint">Начните вводить — выберите из списка или новое значение.</p>
                        <EquipmentCatalogCombobox Value="@item.Manufacturer"
                                                  ValueChanged="@(v => OnManufacturerTextAsync(index, v))"
                                                  Options="@item.Manufacturers"
                                                  Disabled="@_busy"
                                                  Placeholder="Производитель…" />
                    </div>
                    <div class="mrs-field">
                        <label class="mrs-label">Модель</label>
                        <EquipmentCatalogCombobox Value="@item.Model"
                                                  ValueChanged="@(v => { item.Model = v; })"
                                                  Options="@item.Models.Select(m => m.Name).ToList()"
                                                  Disabled="@(_busy || string.IsNullOrWhiteSpace(item.Manufacturer))"
                                                  Placeholder="Модель…" />
                        <p class="mrs-hint">Общий справочник (не привязан к объекту) — доступен и в контрольных листах.</p>
                    </div>
                </details>

                <div class="mrs-field @FieldClass(string.IsNullOrWhiteSpace(item.Label))">
                    <label class="mrs-label">Установка (проектный номер) *</label>
                    <input class="mrs-select" type="text" @bind="item.Label" @bind:event="oninput" disabled="@_busy" />
                </div>
            </div>
        }

        <div class="mrs-form-actions">
            <button type="button" class="mrs-btn-secondary" @onclick="AddInstallation" disabled="@_busy">+ Добавить ещё установку / оборудование</button>
        </div>

        <h2 class="mrs-section-title">Контакты заказчика</h2>
        <p class="mrs-field-hint">Необязательно. Фамилия, имя и отчество — отдельными полями (как в базе сотрудников).</p>

        @for (var i = 0; i < _contacts.Count; i++)
        {
            var index = i;
            var contact = _contacts[index];
            var contactStarted = ContactHasAnyValue(contact);
            <div class="mrs-template-field-card">
                <div class="mrs-template-field-header">
                    <span>Контакт @(index + 1)</span>
                    <button type="button" class="mrs-btn-small-danger" @onclick="() => RemoveContact(index)" disabled="@_busy">Удалить</button>
                </div>
                <div class="mrs-field @FieldClass(contactStarted && string.IsNullOrWhiteSpace(contact.LastName))">
                    <label class="mrs-label">Фамилия *</label>
                    <input class="mrs-select" type="text" @bind="contact.LastName" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field @FieldClass(contactStarted && string.IsNullOrWhiteSpace(contact.FirstName))">
                    <label class="mrs-label">Имя *</label>
                    <input class="mrs-select" type="text" @bind="contact.FirstName" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Отчество</label>
                    <input class="mrs-select" type="text" @bind="contact.MiddleName" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Должность</label>
                    <p class="mrs-field-hint">Начните вводить — выберите из уже внесённых или новое значение.</p>
                    <EquipmentCatalogCombobox Value="@contact.Position"
                                              ValueChanged="@(v => contact.Position = v)"
                                              Options="@_positionOptions"
                                              Disabled="@_busy"
                                              Placeholder="Должность…" />
                </div>
                <div class="mrs-field @(ContactPhoneInvalid(contact) ? "mrs-field-invalid" : null)">
                    <label class="mrs-label">Телефон</label>
                    <input class="mrs-select"
                           type="tel"
                           inputmode="tel"
                           autocomplete="tel"
                           placeholder="+7 (999) 123-45-67"
                           value="@contact.Phone"
                           disabled="@_busy"
                           @oninput="e => OnContactPhoneInput(index, e)" />
                    @if (ContactInputRules.PhoneValidationHint(contact.Phone) is { } phoneHint)
                    {
                        <p class="mrs-field-hint">@phoneHint</p>
                    }
                    else
                    {
                        <p class="mrs-field-hint">11 цифр, формат +7 (XXX) XXX-XX-XX. Можно начать с 8 — подставится +7.</p>
                    }
                </div>
                <div class="mrs-field @(ContactEmailInvalid(contact) ? "mrs-field-invalid" : null)">
                    <label class="mrs-label">Email</label>
                    <input class="mrs-select"
                           type="email"
                           inputmode="email"
                           autocomplete="email"
                           placeholder="name@yandex.ru"
                           value="@contact.Email"
                           disabled="@_busy"
                           @oninput="e => OnContactEmailInput(index, e)" />
                    @if (ContactInputRules.EmailValidationHint(contact.Email) is { } emailHint)
                    {
                        <p class="mrs-field-hint">@emailHint</p>
                    }
                    else
                    {
                        <p class="mrs-field-hint">Любой почтовый сервис (Яндекс, Mail.ru, Gmail и др.).</p>
                    }
                </div>
            </div>
        }

        <div class="mrs-form-actions">
            <button type="button" class="mrs-btn-secondary" @onclick="AddContact" disabled="@_busy">+ Добавить контакт</button>
        </div>
    }

    <div class="mrs-form-actions">
        <button type="button" class="mrs-btn-secondary" @onclick="SaveAndAddAnotherFacilityAsync" disabled="@(_busy || !IsOrgChosen)">+ Добавить ещё объект</button>
        <button type="button" class="mrs-btn-secondary" @onclick="ResetForm" disabled="@_busy">Очистить</button>
        <button type="button" class="mrs-btn-primary" @onclick="SaveAsync" disabled="@_busy">Сохранить в БД</button>
    </div>

    <p class="mrs-info-note">
        «Добавить ещё объект» сначала сохраняет текущий объект (с установками и контактами) в БД, затем открывает форму для следующего.
        Организация остаётся выбранной. Все сохранённые объекты доступны при создании контрольного листа.
    </p>
</div>

@code {
    private readonly List<HierarchyOption> _organizations = [];
    private readonly List<HierarchyOption> _facilities = [];
    private readonly List<HierarchyOption> _equipmentTypes = [];
    private readonly List<InstallationDraft> _installations = [];
    private readonly List<ContactDraft> _contacts = [];
    private readonly List<string> _positionOptions = [];

    private bool _busy;
    private string? _error;
    private string? _saved;
    private bool _highlightMissing;

    private string _orgChoice = "";
    private string _orgSearchText = "";
    private bool _orgDropdownOpen;
    private string _facilityChoice = "";

    private string _newOrgLegalForm = "";
    private string _newFacilityName = "";
    private string _contractAddress = "";
    private string _city = "";
    private string _street = "";
    private string _building = "";
    private string _structure = "";
    private string _block = "";
    private string _zip = "";
    private string _systemDescription = "";

    private bool IsOrgChosen => !string.IsNullOrWhiteSpace(_orgChoice);
    private bool IsFacilityChosen => !string.IsNullOrWhiteSpace(_facilityChoice);
    private bool IsOrgMissing =>
        string.IsNullOrWhiteSpace(_orgChoice)
        || (_orgChoice == "new" && string.IsNullOrWhiteSpace(_orgSearchText));

    private string ResolvedNewCompanyName => (_orgSearchText ?? string.Empty).Trim();

    private string? FieldClass(bool isEmpty) =>
        _highlightMissing && isEmpty ? "mrs-field-invalid" : null;

    private void DismissError()
    {
        _error = null;
    }

    private void ShowError(string message)
    {
        _error = message;
        _highlightMissing = true;
        _saved = null;
    }

    private static bool ContactHasAnyValue(ContactDraft c) =>
        !string.IsNullOrWhiteSpace(c.LastName)
        || !string.IsNullOrWhiteSpace(c.FirstName)
        || !string.IsNullOrWhiteSpace(c.MiddleName)
        || !string.IsNullOrWhiteSpace(c.Position)
        || !string.IsNullOrWhiteSpace(c.Phone)
        || !string.IsNullOrWhiteSpace(c.Email);

    private IEnumerable<HierarchyOption> FilteredOrganizations
    {
        get
        {
            var query = (_orgSearchText ?? string.Empty).Trim();
            if (query.Length == 0)
                return _organizations;

            return _organizations.Where(o =>
                o.Name.Contains(query, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _installations.Add(new InstallationDraft());
        _busy = true;
        try
        {
            _organizations.AddRange(await Hierarchy.GetOrganizationsAsync().ConfigureAwait(false));
            _equipmentTypes.AddRange(await Onboarding.GetAllEquipmentTypesAsync().ConfigureAwait(false));
            _positionOptions.Clear();
            _positionOptions.AddRange(await Onboarding.GetDistinctContactPositionsAsync().ConfigureAwait(false));
            await LoadEquipmentCatalogAsync(0).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnOrgSearchInput(ChangeEventArgs e)
    {
        _orgSearchText = e.Value?.ToString() ?? string.Empty;
        _orgDropdownOpen = true;
        _saved = null;
        _error = null;

        var exact = _organizations.FirstOrDefault(o =>
            string.Equals(o.Name, _orgSearchText.Trim(), StringComparison.OrdinalIgnoreCase));
        if (exact is not null)
        {
            await SelectOrganizationAsync(exact).ConfigureAwait(false);
            return;
        }

        if (_orgChoice != "new")
        {
            _orgChoice = string.Empty;
            await ClearFacilitySectionAsync(keepOrg: false).ConfigureAwait(false);
        }
    }

    private void OnOrgSearchFocus() => _orgDropdownOpen = true;

    private async Task OnOrgSearchBlur()
    {
        await Task.Delay(150).ConfigureAwait(false);
        _orgDropdownOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectOrganizationAsync(HierarchyOption organization)
    {
        _orgChoice = organization.Id.ToString(CultureInfo.InvariantCulture);
        _orgSearchText = organization.Name;
        _orgDropdownOpen = false;
        _newOrgLegalForm = "";
        await ClearFacilitySectionAsync(keepOrg: true).ConfigureAwait(false);
        _saved = null;
        _error = null;

        _busy = true;
        try
        {
            _facilities.AddRange(await Hierarchy.GetFacilitiesAsync(organization.Id).ConfigureAwait(false));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SelectNewOrganization()
    {
        _orgChoice = "new";
        _orgDropdownOpen = false;
        if (string.IsNullOrWhiteSpace(_newOrgLegalForm))
            _newOrgLegalForm = "OOO";
        await ClearFacilitySectionAsync(keepOrg: true).ConfigureAwait(false);
        _saved = null;
        _error = null;
    }

    private Task OnFacilityChoiceChanged(ChangeEventArgs e)
    {
        _facilityChoice = e.Value?.ToString() ?? string.Empty;
        _saved = null;
        _error = null;
        return Task.CompletedTask;
    }

    private async Task OnEquipmentChoiceChanged(int index, ChangeEventArgs e)
    {
        var item = _installations[index];
        item.EquipmentChoice = e.Value?.ToString() ?? string.Empty;
        item.Manufacturer = "";
        item.Model = "";
        item.Manufacturers = [];
        item.Models = [];
        _saved = null;
        _error = null;
        await LoadEquipmentCatalogAsync(index).ConfigureAwait(false);
    }

    private async Task LoadEquipmentCatalogAsync(int index)
    {
        if (index < 0 || index >= _installations.Count)
            return;

        var item = _installations[index];
        // Справочник общий: грузим даже для «нового типа» / до выбора типа.
        var etId = ParseExisting(item.EquipmentChoice) ?? 0;

        try
        {
            item.Manufacturers = (await ModelCatalog.GetManufacturersAsync(etId).ConfigureAwait(false)).ToList();
            if (!string.IsNullOrWhiteSpace(item.Manufacturer))
            {
                item.Models = (await ModelCatalog.GetModelsAsync(etId, item.Manufacturer).ConfigureAwait(false)).ToList();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnManufacturerTextAsync(int index, string value)
    {
        var item = _installations[index];
        item.Manufacturer = value;
        item.Model = "";
        item.Models = [];
        if (string.IsNullOrWhiteSpace(value))
            return;

        var etId = ParseExisting(item.EquipmentChoice) ?? 0;
        item.Models = (await ModelCatalog.GetModelsAsync(etId, value).ConfigureAwait(false)).ToList();
    }

    private async Task OnManufacturerChangedAsync(int index)
    {
        var item = _installations[index];
        item.Model = "";
        item.Models = [];
        if (string.IsNullOrWhiteSpace(item.Manufacturer))
            return;

        var etId = ParseExisting(item.EquipmentChoice) ?? 0;
        item.Models = (await ModelCatalog.GetModelsAsync(etId, item.Manufacturer).ConfigureAwait(false)).ToList();
    }

    private async Task AddInstallation()
    {
        _installations.Add(new InstallationDraft());
        await LoadEquipmentCatalogAsync(_installations.Count - 1).ConfigureAwait(false);
    }

    private void RemoveInstallation(int index)
    {
        if (_installations.Count <= 1)
            return;
        _installations.RemoveAt(index);
    }

    private void AddContact() => _contacts.Add(new ContactDraft());

    private void RemoveContact(int index) => _contacts.RemoveAt(index);

    private static bool ContactPhoneInvalid(ContactDraft c) =>
        !string.IsNullOrWhiteSpace(c.Phone) && !ContactInputRules.IsPhoneValidOrEmpty(c.Phone);

    private static bool ContactEmailInvalid(ContactDraft c) =>
        !string.IsNullOrWhiteSpace(c.Email) && !ContactInputRules.IsEmailValidOrEmpty(c.Email);

    private void OnContactPhoneInput(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _contacts.Count)
            return;
        _contacts[index].Phone = ContactInputRules.FormatPhoneInput(e.Value?.ToString());
    }

    private void OnContactEmailInput(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _contacts.Count)
            return;
        _contacts[index].Email = e.Value?.ToString() ?? string.Empty;
    }

    private async Task SaveAsync() => await SaveAndPrepareNextAsync().ConfigureAwait(false);

    /// <summary>
    /// Сохраняет текущий объект в БД и готовит форму для следующего под той же организацией.
    /// Раньше кнопка только очищала поля и показывала ложное «сохранено».
    /// </summary>
    private async Task SaveAndAddAnotherFacilityAsync() => await SaveAndPrepareNextAsync().ConfigureAwait(false);

    private async Task SaveAndPrepareNextAsync()
    {
        _error = null;
        _saved = null;
        if (!TryValidateForSave(out var validationError))
        {
            ShowError(validationError);
            return;
        }

        _busy = true;
        try
        {
            var installations = _installations.Select(i => new ObjectOnboardingInstallationDraft(
                ExistingEquipmentTypeId: ParseExisting(i.EquipmentChoice),
                NewEquipmentTypeName: i.EquipmentChoice == "new" ? i.NewEquipmentTypeName : null,
                InstallationLabel: i.Label,
                InstallationManufacturer: i.Manufacturer,
                InstallationModel: i.Model,
                InstallationSerialNumber: i.Serial)).ToList();

            var contacts = _contacts
                .Where(ContactHasAnyValue)
                .Select(c => new ObjectOnboardingContactDraft(
                    c.LastName,
                    c.FirstName,
                    c.MiddleName,
                    string.IsNullOrWhiteSpace(c.Position) ? null : c.Position.Trim(),
                    string.IsNullOrWhiteSpace(c.Phone) ? null : ContactInputRules.FormatPhoneInput(c.Phone),
                    string.IsNullOrWhiteSpace(c.Email) ? null : c.Email.Trim()))
                .ToList();

            var request = new ObjectOnboardingRequest(
                ExistingOrganizationId: ParseExisting(_orgChoice),
                NewOrganizationLegalFormCode: _orgChoice == "new" ? _newOrgLegalForm : null,
                NewOrganizationCompanyName: _orgChoice == "new" ? ResolvedNewCompanyName : null,
                ExistingFacilityId: ParseExisting(_facilityChoice),
                NewFacilityName: _facilityChoice == "new" ? _newFacilityName : null,
                ContractAddress: _facilityChoice == "new" ? _contractAddress : null,
                AddressCity: _facilityChoice == "new" ? _city : null,
                AddressStreet: _facilityChoice == "new" ? _street : null,
                AddressBuilding: _facilityChoice == "new" ? _building : null,
                AddressStructure: _facilityChoice == "new" ? _structure : null,
                AddressBlock: _facilityChoice == "new" ? _block : null,
                AddressZipCode: _facilityChoice == "new" ? _zip : null,
                SystemDescription: IsFacilityChosen ? _systemDescription : null,
                Installations: installations,
                Contacts: contacts);

            var result = await Onboarding.UpsertHierarchyAsync(request).ConfigureAwait(false);
            _highlightMissing = false;
            _saved = BuildSavedMessage(result);

            await RefreshLookupsAfterSaveAsync(result).ConfigureAwait(false);
            await PrepareForAnotherEntryKeepOrganizationAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private bool TryValidateForSave(out string error)
    {
        if (string.IsNullOrWhiteSpace(_orgChoice))
        {
            error = "Выберите или создайте организацию.";
            return false;
        }

        if (_orgChoice == "new")
        {
            if (string.IsNullOrWhiteSpace(_newOrgLegalForm))
            {
                error = "Укажите юридический статус.";
                return false;
            }

            if (string.IsNullOrWhiteSpace(ResolvedNewCompanyName))
            {
                error = "Укажите название организации.";
                return false;
            }
        }

        if (string.IsNullOrWhiteSpace(_facilityChoice))
        {
            error = "Выберите или создайте объект перед сохранением.";
            return false;
        }

        if (_facilityChoice == "new")
        {
            if (string.IsNullOrWhiteSpace(_newFacilityName))
            {
                error = "Укажите краткое название объекта.";
                return false;
            }

            if (string.IsNullOrWhiteSpace(_city) || string.IsNullOrWhiteSpace(_street) || string.IsNullOrWhiteSpace(_building))
            {
                error = "Для нового объекта заполните реальный адрес: город, улица и дом.";
                return false;
            }
        }

        if (_installations.Count == 0)
        {
            error = "Добавьте хотя бы одну установку (оборудование).";
            return false;
        }

        foreach (var inst in _installations)
        {
            if (string.IsNullOrWhiteSpace(inst.EquipmentChoice))
            {
                error = "Выберите тип оборудования для каждой установки.";
                return false;
            }

            if (inst.EquipmentChoice == "new" && string.IsNullOrWhiteSpace(inst.NewEquipmentTypeName))
            {
                error = "Укажите название нового типа оборудования.";
                return false;
            }

            if (string.IsNullOrWhiteSpace(inst.Label))
            {
                error = "Укажите проектный номер установки.";
                return false;
            }
        }

        foreach (var contact in _contacts.Where(ContactHasAnyValue))
        {
            if (string.IsNullOrWhiteSpace(contact.LastName) || string.IsNullOrWhiteSpace(contact.FirstName))
            {
                error = "Для контакта укажите фамилию и имя отдельными полями.";
                return false;
            }

            if (!ContactInputRules.IsPhoneValidOrEmpty(contact.Phone))
            {
                error = ContactInputRules.PhoneValidationHint(contact.Phone)
                        ?? "Проверьте телефон контакта.";
                return false;
            }

            if (!ContactInputRules.IsEmailValidOrEmpty(contact.Email))
            {
                error = ContactInputRules.EmailValidationHint(contact.Email)
                        ?? "Проверьте email контакта.";
                return false;
            }
        }

        error = string.Empty;
        return true;
    }

    private async Task RefreshLookupsAfterSaveAsync(ObjectOnboardingResult result)
    {
        _organizations.Clear();
        _organizations.AddRange(await Hierarchy.GetOrganizationsAsync().ConfigureAwait(false));
        _equipmentTypes.Clear();
        _equipmentTypes.AddRange(await Onboarding.GetAllEquipmentTypesAsync().ConfigureAwait(false));
        _positionOptions.Clear();
        _positionOptions.AddRange(await Onboarding.GetDistinctContactPositionsAsync().ConfigureAwait(false));

        _orgChoice = result.OrganizationId.ToString(CultureInfo.InvariantCulture);
        var org = _organizations.FirstOrDefault(o => o.Id == result.OrganizationId);
        if (org is not null)
            _orgSearchText = org.Name;
        _newOrgLegalForm = "";

        _facilities.Clear();
        _facilities.AddRange(await Hierarchy.GetFacilitiesAsync(result.OrganizationId).ConfigureAwait(false));
    }

    private async Task PrepareForAnotherEntryKeepOrganizationAsync()
    {
        await ClearFacilitySectionAsync(keepOrg: true).ConfigureAwait(false);
        // Сразу форма нового объекта — организация уже в БД и выбрана.
        _facilityChoice = "new";
    }

    private async Task ClearFacilitySectionAsync(bool keepOrg)
    {
        if (!keepOrg)
            _facilities.Clear();

        _facilityChoice = "";
        _newFacilityName = "";
        _contractAddress = "";
        _city = "";
        _street = "";
        _building = "";
        _structure = "";
        _block = "";
        _zip = "";
        _systemDescription = "";
        _installations.Clear();
        _installations.Add(new InstallationDraft());
        _contacts.Clear();
        await LoadEquipmentCatalogAsync(0).ConfigureAwait(false);
    }

    private async Task ResetForm()
    {
        _error = null;
        _saved = null;
        _highlightMissing = false;
        _orgChoice = "";
        _orgSearchText = "";
        _orgDropdownOpen = false;
        _newOrgLegalForm = "";
        await ClearFacilitySectionAsync(keepOrg: false).ConfigureAwait(false);
    }

    private static int? ParseExisting(string choice) =>
        int.TryParse(choice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : null;

    private static string BuildSavedMessage(ObjectOnboardingResult result)
    {
        var parts = new List<string>();
        if (result.OrganizationCreated) parts.Add("организация");
        if (result.FacilityCreated) parts.Add("объект");
        if (result.SystemCreated) parts.Add("система");
        if (result.InstallationsSaved > 0) parts.Add($"установок: {result.InstallationsSaved}");
        if (result.ContactsSaved > 0) parts.Add($"контактов: {result.ContactsSaved}");
        var body = parts.Count == 0
            ? "Данные сохранены (использованы текущие записи)."
            : $"Предыдущие данные сохранены ({string.Join(", ", parts)}).";
        return body + " Можно добавить ещё.";
    }

    private sealed class InstallationDraft
    {
        public string EquipmentChoice { get; set; } = "";
        public string NewEquipmentTypeName { get; set; } = "";
        public string Label { get; set; } = "";
        public string Manufacturer { get; set; } = "";
        public string Model { get; set; } = "";
        public string Serial { get; set; } = "";
        public List<string> Manufacturers { get; set; } = [];
        public List<EquipmentModelListItem> Models { get; set; } = [];
    }

    private sealed class ContactDraft
    {
        public string LastName { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string MiddleName { get; set; } = "";
        public string Position { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }
}
