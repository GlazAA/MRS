@page "/objects/register"
@using System.Globalization
@using MRS.Application.Checklists
@using MRS.Application.Facilities
@inject IFacilityHierarchyService Hierarchy
@inject IObjectOnboardingService Onboarding
@inject IEquipmentModelCatalogService ModelCatalog

<PageTitle>Внесение данных по объекту</PageTitle>

<div class="mrs-toolbar">
    <a class="mrs-back" href="/objects">←</a>
    <h1 class="mrs-title">Внесение данных по объекту</h1>
    <MrsTopMenu />
</div>

@if (_error is not null)
{
    <p class="text-danger">@_error</p>
}

@if (_saved is not null)
{
    <p class="mrs-save-msg">@_saved</p>
}

<div class="mrs-object-form">
    <div class="mrs-field">
        <label class="mrs-label">Организация *</label>
        <div class="mrs-combobox">
            <input class="mrs-select"
                   type="text"
                   placeholder="Начните вводить название…"
                   value="@_orgSearchText"
                   @oninput="OnOrgSearchInput"
                   @onfocus="OnOrgSearchFocus"
                   @onblur="OnOrgSearchBlur"
                   disabled="@_busy"
                   autocomplete="off" />
            @if (_orgDropdownOpen)
            {
                <ul class="mrs-combobox-list" @onmousedown:preventDefault="true">
                    @foreach (var o in FilteredOrganizations)
                    {
                        <li class="mrs-combobox-item" @onclick="() => SelectOrganizationAsync(o)">@o.Name</li>
                    }
                    @if (!FilteredOrganizations.Any() && !string.IsNullOrWhiteSpace(_orgSearchText))
                    {
                        <li class="mrs-combobox-empty">Совпадений нет</li>
                    }
                    <li class="mrs-combobox-item mrs-combobox-item-new" @onclick="SelectNewOrganization">+ Новая организация</li>
                </ul>
            }
        </div>
    </div>

    @if (_orgChoice == "new")
    {
        <div class="mrs-field">
            <label class="mrs-label">Юридический статус *</label>
            <select class="mrs-select" @bind="_newOrgLegalForm" disabled="@_busy">
                <option value="">— выберите —</option>
                @foreach (var form in OrganizationLegalForm.Choices)
                {
                    <option value="@form.Code">@form.ShortLabel</option>
                }
            </select>
        </div>
        <div class="mrs-field">
            <label class="mrs-label">Название компании *</label>
            <input class="mrs-select" type="text" @bind="_newOrgCompanyName" @bind:event="oninput" disabled="@_busy" />
            <p class="mrs-field-hint">Указывается полное название без юридического статуса и кавычек.</p>
        </div>
    }

    <div class="mrs-field">
        <label class="mrs-label">Объект *</label>
        <select class="mrs-select" value="@_facilityChoice" @onchange="OnFacilityChoiceChanged" disabled="@(_busy || !IsOrgChosen)">
            <option value="">— выберите —</option>
            @foreach (var f in _facilities)
            {
                <option value="@f.Id.ToString(CultureInfo.InvariantCulture)">@f.Name</option>
            }
            <option value="new">+ Новый объект</option>
        </select>
    </div>

    @if (_facilityChoice == "new")
    {
        <div class="mrs-field">
            <label class="mrs-label">Название объекта для акта *</label>
            <input class="mrs-select" type="text" @bind="_newFacilityName" @bind:event="oninput" disabled="@_busy" />
        </div>

        <div class="mrs-field">
            <label class="mrs-label">Адрес объекта по договору</label>
            <input class="mrs-select" type="text" @bind="_contractAddress" @bind:event="oninput" disabled="@_busy" />
        </div>

        <div class="mrs-field">
            <label class="mrs-label">Город *</label>
            <input class="mrs-select" type="text" @bind="_city" @bind:event="oninput" disabled="@_busy" />
        </div>

        <div class="mrs-field">
            <label class="mrs-label">Улица *</label>
            <input class="mrs-select" type="text" @bind="_street" @bind:event="oninput" disabled="@_busy" />
        </div>

        <p class="mrs-address-hint">Реальный адрес объекта</p>
        <div class="mrs-address-row">
            <div class="mrs-field">
                <label class="mrs-label">Индекс</label>
                <input class="mrs-select" type="text" @bind="_zip" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Дом *</label>
                <input class="mrs-select" type="text" @bind="_building" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Строение</label>
                <input class="mrs-select" type="text" @bind="_structure" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="mrs-field">
                <label class="mrs-label">Корпус</label>
                <input class="mrs-select" type="text" @bind="_block" @bind:event="oninput" disabled="@_busy" />
            </div>
        </div>
    }

    @if (IsFacilityChosen)
    {
        <div class="mrs-field">
            <label class="mrs-label">Описание системы</label>
            <textarea class="mrs-select" rows="3" @bind="_systemDescription" @bind:event="oninput" disabled="@_busy"></textarea>
            <p class="mrs-field-hint">Для внутреннего пользования (не для документов)</p>
        </div>

        <h2 class="mrs-section-title">Установки / оборудование</h2>
        @for (var i = 0; i < _installations.Count; i++)
        {
            var index = i;
            var item = _installations[index];
            <div class="mrs-template-field-card">
                <div class="mrs-template-field-header">
                    <span>Установка @(index + 1)</span>
                    @if (_installations.Count > 1)
                    {
                        <button type="button" class="mrs-btn-small-danger" @onclick="() => RemoveInstallation(index)" disabled="@_busy">Удалить</button>
                    }
                </div>

                <div class="mrs-field">
                    <label class="mrs-label">Тип оборудования *</label>
                    <select class="mrs-select" value="@item.EquipmentChoice" @onchange="e => OnEquipmentChoiceChanged(index, e)" disabled="@_busy">
                        <option value="">— выберите —</option>
                        @foreach (var et in _equipmentTypes)
                        {
                            <option value="@et.Id.ToString(CultureInfo.InvariantCulture)">@et.Name</option>
                        }
                        <option value="new">+ Новый тип оборудования</option>
                    </select>
                </div>

                @if (item.EquipmentChoice == "new")
                {
                    <div class="mrs-field">
                        <label class="mrs-label">Название типа оборудования *</label>
                        <input class="mrs-select" type="text" @bind="item.NewEquipmentTypeName" @bind:event="oninput" disabled="@_busy" />
                    </div>
                }

                <div class="mrs-field">
                    <label class="mrs-label">Серийный номер</label>
                    <input class="mrs-select" type="text" @bind="item.Serial" @bind:event="oninput" disabled="@_busy" />
                </div>

                <details class="mrs-object-details">
                    <summary>Дополнительно по установке</summary>
                    <div class="mrs-field mrs-mt">
                        <label class="mrs-label">Производитель</label>
                        <input class="mrs-select" type="text" list="@($"mfg-{index}")" @bind="item.Manufacturer" @bind:event="oninput" @bind:after="() => OnManufacturerChangedAsync(index)" disabled="@_busy" />
                        <datalist id="@($"mfg-{index}")">
                            @foreach (var mfg in item.Manufacturers)
                            {
                                <option value="@mfg"></option>
                            }
                        </datalist>
                    </div>
                    <div class="mrs-field">
                        <label class="mrs-label">Модель</label>
                        <input class="mrs-select" type="text" list="@($"model-{index}")" @bind="item.Model" @bind:event="oninput" disabled="@(_busy || string.IsNullOrWhiteSpace(item.Manufacturer))" />
                        <datalist id="@($"model-{index}")">
                            @foreach (var m in item.Models)
                            {
                                <option value="@m.Name"></option>
                            }
                        </datalist>
                    </div>
                </details>

                <div class="mrs-field">
                    <label class="mrs-label">Установка (проектный номер) *</label>
                    <input class="mrs-select" type="text" @bind="item.Label" @bind:event="oninput" disabled="@_busy" />
                </div>
            </div>
        }

        <div class="mrs-form-actions">
            <button type="button" class="mrs-btn-secondary" @onclick="AddInstallation" disabled="@_busy">+ Добавить ещё установку / оборудование</button>
        </div>

        <h2 class="mrs-section-title">Контакты заказчика</h2>
        <p class="mrs-field-hint">Необязательно. Фамилия, имя и отчество — отдельными полями (как в базе сотрудников).</p>

        @for (var i = 0; i < _contacts.Count; i++)
        {
            var index = i;
            var contact = _contacts[index];
            <div class="mrs-template-field-card">
                <div class="mrs-template-field-header">
                    <span>Контакт @(index + 1)</span>
                    <button type="button" class="mrs-btn-small-danger" @onclick="() => RemoveContact(index)" disabled="@_busy">Удалить</button>
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Фамилия *</label>
                    <input class="mrs-select" type="text" @bind="contact.LastName" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Имя *</label>
                    <input class="mrs-select" type="text" @bind="contact.FirstName" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Отчество</label>
                    <input class="mrs-select" type="text" @bind="contact.MiddleName" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Должность</label>
                    <input class="mrs-select" type="text" @bind="contact.Position" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Телефон</label>
                    <input class="mrs-select" type="text" @bind="contact.Phone" @bind:event="oninput" disabled="@_busy" />
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Email</label>
                    <input class="mrs-select" type="email" @bind="contact.Email" @bind:event="oninput" disabled="@_busy" />
                </div>
            </div>
        }

        <div class="mrs-form-actions">
            <button type="button" class="mrs-btn-secondary" @onclick="AddContact" disabled="@_busy">+ Добавить контакт</button>
        </div>
    }

    <div class="mrs-form-actions">
        <button type="button" class="mrs-btn-secondary" @onclick="PrepareAnotherFacility" disabled="@(_busy || !IsOrgChosen)">+ Добавить ещё объект</button>
        <button type="button" class="mrs-btn-secondary" @onclick="ResetForm" disabled="@_busy">Очистить</button>
        <button type="button" class="mrs-btn-primary" @onclick="SaveAsync" disabled="@_busy">Сохранить в БД</button>
    </div>

    <p class="mrs-info-note">
        После сохранения остаётесь на странице — можно сразу добавить ещё объект, установку или контакт. Данные уже доступны при создании контрольного листа.
    </p>
</div>

@code {
    private readonly List<HierarchyOption> _organizations = [];
    private readonly List<HierarchyOption> _facilities = [];
    private readonly List<HierarchyOption> _equipmentTypes = [];
    private readonly List<InstallationDraft> _installations = [];
    private readonly List<ContactDraft> _contacts = [];

    private bool _busy;
    private string? _error;
    private string? _saved;

    private string _orgChoice = "";
    private string _orgSearchText = "";
    private bool _orgDropdownOpen;
    private string _facilityChoice = "";

    private string _newOrgLegalForm = "";
    private string _newOrgCompanyName = "";
    private string _newFacilityName = "";
    private string _contractAddress = "";
    private string _city = "";
    private string _street = "";
    private string _building = "";
    private string _structure = "";
    private string _block = "";
    private string _zip = "";
    private string _systemDescription = "";

    private bool IsOrgChosen => !string.IsNullOrWhiteSpace(_orgChoice);
    private bool IsFacilityChosen => !string.IsNullOrWhiteSpace(_facilityChoice);

    private IEnumerable<HierarchyOption> FilteredOrganizations
    {
        get
        {
            var query = (_orgSearchText ?? string.Empty).Trim();
            if (query.Length == 0)
                return _organizations;

            return _organizations.Where(o =>
                o.Name.Contains(query, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _installations.Add(new InstallationDraft());
        _busy = true;
        try
        {
            _organizations.AddRange(await Hierarchy.GetOrganizationsAsync().ConfigureAwait(false));
            _equipmentTypes.AddRange(await Onboarding.GetAllEquipmentTypesAsync().ConfigureAwait(false));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnOrgSearchInput(ChangeEventArgs e)
    {
        _orgSearchText = e.Value?.ToString() ?? string.Empty;
        _orgDropdownOpen = true;
        _saved = null;
        _error = null;

        var exact = _organizations.FirstOrDefault(o =>
            string.Equals(o.Name, _orgSearchText.Trim(), StringComparison.OrdinalIgnoreCase));
        if (exact is not null)
        {
            await SelectOrganizationAsync(exact).ConfigureAwait(false);
            return;
        }

        if (_orgChoice != "new")
        {
            _orgChoice = string.Empty;
            ClearFacilitySection(keepOrg: false);
        }
    }

    private void OnOrgSearchFocus() => _orgDropdownOpen = true;

    private async Task OnOrgSearchBlur()
    {
        await Task.Delay(150).ConfigureAwait(false);
        _orgDropdownOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectOrganizationAsync(HierarchyOption organization)
    {
        _orgChoice = organization.Id.ToString(CultureInfo.InvariantCulture);
        _orgSearchText = organization.Name;
        _orgDropdownOpen = false;
        _newOrgLegalForm = "";
        _newOrgCompanyName = "";
        ClearFacilitySection(keepOrg: true);
        _saved = null;
        _error = null;

        _busy = true;
        try
        {
            _facilities.AddRange(await Hierarchy.GetFacilitiesAsync(organization.Id).ConfigureAwait(false));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void SelectNewOrganization()
    {
        _orgChoice = "new";
        _orgDropdownOpen = false;
        if (string.IsNullOrWhiteSpace(_newOrgCompanyName))
            _newOrgCompanyName = _orgSearchText.Trim();
        if (string.IsNullOrWhiteSpace(_newOrgLegalForm))
            _newOrgLegalForm = "OOO";
        ClearFacilitySection(keepOrg: true);
        _saved = null;
        _error = null;
    }

    private Task OnFacilityChoiceChanged(ChangeEventArgs e)
    {
        _facilityChoice = e.Value?.ToString() ?? string.Empty;
        _saved = null;
        _error = null;
        return Task.CompletedTask;
    }

    private async Task OnEquipmentChoiceChanged(int index, ChangeEventArgs e)
    {
        var item = _installations[index];
        item.EquipmentChoice = e.Value?.ToString() ?? string.Empty;
        item.Manufacturer = "";
        item.Model = "";
        item.Manufacturers = [];
        item.Models = [];
        _saved = null;
        _error = null;
        await LoadEquipmentCatalogAsync(index).ConfigureAwait(false);
    }

    private async Task LoadEquipmentCatalogAsync(int index)
    {
        var item = _installations[index];
        var equipmentTypeId = ParseExisting(item.EquipmentChoice);
        if (equipmentTypeId is not int etId)
            return;

        try
        {
            item.Manufacturers = (await ModelCatalog.GetManufacturersAsync(etId).ConfigureAwait(false)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task OnManufacturerChangedAsync(int index)
    {
        var item = _installations[index];
        item.Model = "";
        item.Models = [];
        var equipmentTypeId = ParseExisting(item.EquipmentChoice);
        if (equipmentTypeId is not int etId || string.IsNullOrWhiteSpace(item.Manufacturer))
            return;

        item.Models = (await ModelCatalog.GetModelsAsync(etId, item.Manufacturer).ConfigureAwait(false)).ToList();
    }

    private void AddInstallation() => _installations.Add(new InstallationDraft());

    private void RemoveInstallation(int index)
    {
        if (_installations.Count <= 1)
            return;
        _installations.RemoveAt(index);
    }

    private void AddContact() => _contacts.Add(new ContactDraft());

    private void RemoveContact(int index) => _contacts.RemoveAt(index);

    private async Task SaveAsync()
    {
        _error = null;
        _saved = null;
        _busy = true;
        try
        {
            var installations = _installations.Select(i => new ObjectOnboardingInstallationDraft(
                ExistingEquipmentTypeId: ParseExisting(i.EquipmentChoice),
                NewEquipmentTypeName: i.EquipmentChoice == "new" ? i.NewEquipmentTypeName : null,
                InstallationLabel: i.Label,
                InstallationManufacturer: i.Manufacturer,
                InstallationModel: i.Model,
                InstallationSerialNumber: i.Serial)).ToList();

            var contacts = _contacts
                .Where(c => !string.IsNullOrWhiteSpace(c.LastName) || !string.IsNullOrWhiteSpace(c.FirstName)
                            || !string.IsNullOrWhiteSpace(c.Phone) || !string.IsNullOrWhiteSpace(c.Email))
                .Select(c => new ObjectOnboardingContactDraft(
                    c.LastName, c.FirstName, c.MiddleName, c.Position, c.Phone, c.Email))
                .ToList();

            var request = new ObjectOnboardingRequest(
                ExistingOrganizationId: ParseExisting(_orgChoice),
                NewOrganizationLegalFormCode: _orgChoice == "new" ? _newOrgLegalForm : null,
                NewOrganizationCompanyName: _orgChoice == "new" ? _newOrgCompanyName : null,
                ExistingFacilityId: ParseExisting(_facilityChoice),
                NewFacilityName: _facilityChoice == "new" ? _newFacilityName : null,
                ContractAddress: _facilityChoice == "new" ? _contractAddress : null,
                AddressCity: _facilityChoice == "new" ? _city : null,
                AddressStreet: _facilityChoice == "new" ? _street : null,
                AddressBuilding: _facilityChoice == "new" ? _building : null,
                AddressStructure: _facilityChoice == "new" ? _structure : null,
                AddressBlock: _facilityChoice == "new" ? _block : null,
                AddressZipCode: _facilityChoice == "new" ? _zip : null,
                SystemDescription: IsFacilityChosen ? _systemDescription : null,
                Installations: installations,
                Contacts: contacts);

            var result = await Onboarding.UpsertHierarchyAsync(request).ConfigureAwait(false);
            _saved = BuildSavedMessage(result);

            // После сохранения остаёмся на странице и подтягиваем справочники для продолжения ввода.
            await RefreshLookupsAfterSaveAsync(result).ConfigureAwait(false);
            PrepareForAnotherEntryKeepOrganization();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RefreshLookupsAfterSaveAsync(ObjectOnboardingResult result)
    {
        _organizations.Clear();
        _organizations.AddRange(await Hierarchy.GetOrganizationsAsync().ConfigureAwait(false));
        _equipmentTypes.Clear();
        _equipmentTypes.AddRange(await Onboarding.GetAllEquipmentTypesAsync().ConfigureAwait(false));

        _orgChoice = result.OrganizationId.ToString(CultureInfo.InvariantCulture);
        var org = _organizations.FirstOrDefault(o => o.Id == result.OrganizationId);
        if (org is not null)
            _orgSearchText = org.Name;
        _newOrgLegalForm = "";
        _newOrgCompanyName = "";

        _facilities.Clear();
        _facilities.AddRange(await Hierarchy.GetFacilitiesAsync(result.OrganizationId).ConfigureAwait(false));
    }

    private void PrepareForAnotherEntryKeepOrganization()
    {
        ClearFacilitySection(keepOrg: true);
    }

    private void PrepareAnotherFacility()
    {
        _saved = "Можно вносить следующий объект — предыдущие данные сохранены.";
        _error = null;
        ClearFacilitySection(keepOrg: true);
    }

    private void ClearFacilitySection(bool keepOrg)
    {
        if (!keepOrg)
            _facilities.Clear();

        _facilityChoice = "";
        _newFacilityName = "";
        _contractAddress = "";
        _city = "";
        _street = "";
        _building = "";
        _structure = "";
        _block = "";
        _zip = "";
        _systemDescription = "";
        _installations.Clear();
        _installations.Add(new InstallationDraft());
        _contacts.Clear();
        if (!keepOrg)
            _facilities.Clear();
    }

    private void ResetForm()
    {
        _error = null;
        _saved = null;
        _orgChoice = "";
        _orgSearchText = "";
        _orgDropdownOpen = false;
        _newOrgLegalForm = "";
        _newOrgCompanyName = "";
        ClearFacilitySection(keepOrg: false);
    }

    private static int? ParseExisting(string choice) =>
        int.TryParse(choice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : null;

    private static string BuildSavedMessage(ObjectOnboardingResult result)
    {
        var parts = new List<string>();
        if (result.OrganizationCreated) parts.Add("организация");
        if (result.FacilityCreated) parts.Add("объект");
        if (result.SystemCreated) parts.Add("система");
        if (result.InstallationsSaved > 0) parts.Add($"установок: {result.InstallationsSaved}");
        if (result.ContactsSaved > 0) parts.Add($"контактов: {result.ContactsSaved}");
        var body = parts.Count == 0
            ? "Данные сохранены (использованы текущие записи)."
            : $"Предыдущие данные сохранены ({string.Join(", ", parts)}).";
        return body + " Можно добавить ещё.";
    }

    private sealed class InstallationDraft
    {
        public string EquipmentChoice { get; set; } = "";
        public string NewEquipmentTypeName { get; set; } = "";
        public string Label { get; set; } = "";
        public string Manufacturer { get; set; } = "";
        public string Model { get; set; } = "";
        public string Serial { get; set; } = "";
        public List<string> Manufacturers { get; set; } = [];
        public List<EquipmentModelListItem> Models { get; set; } = [];
    }

    private sealed class ContactDraft
    {
        public string LastName { get; set; } = "";
        public string FirstName { get; set; } = "";
        public string MiddleName { get; set; } = "";
        public string Position { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
    }
}
