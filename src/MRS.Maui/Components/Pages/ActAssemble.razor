@page "/checklists/acts"
@using System.Globalization
@using MRS.Application
@using MRS.Application.Checklists
@using MRS.Application.Facilities
@using MRS.Maui.Services
@using Microsoft.Maui.Devices
@inject IChecklistManagementService ChecklistManagement
@inject IFacilityHierarchyService FacilityHierarchy
@inject IInstallationQueryService InstallationQuery
@inject IActAssemblyPrototypeService ActAssembly
@inject IAppFileSaveService FileSave

<PageTitle>Сборка акта</PageTitle>

<div class="mrs-toolbar">
    <a class="mrs-back" href="/">←</a>
    <h1 class="mrs-title">Сборка акта</h1>
    <MrsTopMenu />
</div>

@if (_busy)
{
    <p>Загрузка…</p>
}

<MrsErrorModal Message="@_error" OnClose="DismissError" />

@if (!_busy)
{
<section class="mrs-act-step">
    <h2 class="mrs-info-title">1. Выберите контрольные листы</h2>
    <div class="mrs-filter-row">
        <div class="mrs-field mrs-field-inline">
            <label class="mrs-label">Объект</label>
            <select class="mrs-select" value="@_objectFilter" @onchange="OnObjectFilterChanged">
                <option value="all">Все</option>
                @foreach (var opt in _objectOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
        <div class="mrs-field mrs-field-inline">
            <label class="mrs-label">№ установки</label>
            <select class="mrs-select" value="@_installationFilter" @onchange="OnInstallationFilterChanged">
                <option value="all">Все</option>
                @foreach (var opt in _installationOptions)
                {
                    <option value="@opt">@opt</option>
                }
            </select>
        </div>
    </div>

    <div class="mrs-act-select-bar">
        <button type="button"
                class="mrs-btn-secondary mrs-act-select-btn"
                @onclick="SelectAllFiltered"
                disabled="@(_filteredRows.Count == 0)">
            Выделить все
        </button>
        <button type="button"
                class="mrs-btn-secondary mrs-act-select-btn"
                @onclick="ClearSelection"
                disabled="@(_selectedIds.Count == 0)">
            Снять все
        </button>
    </div>

    <section class="mrs-list-window">
        @foreach (var row in _filteredRows)
        {
            <label class="mrs-worklist-item mrs-act-pick">
                <input type="checkbox"
                       class="mrs-worklist-checkbox"
                       checked="@_selectedIds.Contains(row.ChecklistId)"
                       @onchange="(e) => ToggleSelected(row.ChecklistId, e)" />
                <div>
                    <div class="mrs-worklist-title">@FormatRowTitle(row)</div>
                    <div class="mrs-info-note">@row.OrganizationName • @row.EquipmentTypeName • @row.InstallationLabel</div>
                </div>
            </label>
        }
        @if (_filteredRows.Count == 0)
        {
            <p class="mrs-info-note">Нет контрольных листов по фильтру. Перезапустите приложение, если только что обновляли БД.</p>
        }
    </section>
    <p class="mrs-info-note">Выбрано: @_selectedIds.Count из @_filteredRows.Count</p>
</section>

<section class="mrs-act-step">
    <h2 class="mrs-info-title">2. Что сформировать?</h2>
    <label class="mrs-check-label mrs-act-option">
        <input class="mrs-check" type="checkbox" @bind="_wantInstallationAct" />
        <span><strong>Акт по установке</strong> — «компоненты установки», одна страница на выбранные КЛ.</span>
    </label>
    <label class="mrs-check-label mrs-act-option">
        <input class="mrs-check" type="checkbox" @bind="_wantUnitActs" />
        <span><strong>Акты по единицам</strong> — отдельный бланк на каждый КЛ (компрессор / осушитель / …).</span>
    </label>

    <div class="mrs-form-actions">
        <button type="button"
                class="mrs-btn-primary"
                disabled="@(_selectedIds.Count == 0 || (!_wantInstallationAct && !_wantUnitActs) || _building)"
                @onclick="BuildDraftsAsync">
            @(_building ? "Собираю…" : "Собрать акт")
        </button>
    </div>
</section>

@if (_preview is not null)
{
    <section class="mrs-act-step">
        <h2 class="mrs-info-title">3. Проверьте текст перед скачиванием</h2>
        <p class="mrs-info-note">Источник: @_preview.SourceRows.Count КЛ. «Доп. работы» и «Замечания» склеены автоматически — при необходимости поправьте.</p>

        @if (_wantInstallationAct && _installationDraft is not null)
        {
            <div class="mrs-act-card">
                <h3 class="mrs-act-card-title">@_installationDraft.Title</h3>
                <p class="mrs-info-note">
                    @_installationDraft.Customer · @_installationDraft.WorkDates · уст. @_installationDraft.InstallationLabel · @_installationDraft.WorkKind
                </p>
                <p class="mrs-info-note">Объект: @_installationDraft.ObjectAddress</p>
                @if (!string.IsNullOrWhiteSpace(_installationDraft.EquipmentStateDisplay))
                {
                    <p class="mrs-info-note">Состояние оборудования: @_installationDraft.EquipmentStateDisplay</p>
                }
                else
                {
                    <p class="mrs-info-note">Состояние оборудования: не найдено в выбранных КЛ (нужен ответ «comp_state», обычно в КЛ компрессора).</p>
                }
                <p class="mrs-label">Перечень работ</p>
                <ul class="mrs-act-works">
                    @foreach (var line in _installationDraft.WorkLines)
                    {
                        <li><span class="mrs-act-mark">@line.Mark</span> @line.Label</li>
                    }
                </ul>
                <div class="mrs-field">
                    <label class="mrs-label">Дополнительные работы</label>
                    <textarea class="mrs-select" rows="4" @bind="_installationDraft.ExtraWorksText" @bind:event="oninput"></textarea>
                </div>
                <div class="mrs-field">
                    <label class="mrs-label">Замечания и рекомендации</label>
                    <textarea class="mrs-select" rows="4" @bind="_installationDraft.RemarksText" @bind:event="oninput"></textarea>
                </div>
                    <button type="button" class="mrs-btn-secondary" disabled="@_exporting" @onclick="() => AskDownloadFormat(_installationDraft)">
                    Скачать этот акт
                </button>
            </div>
        }

        @if (_wantUnitActs)
        {
            @foreach (var draft in _unitDrafts)
            {
                <div class="mrs-act-card">
                    <h3 class="mrs-act-card-title">@draft.Title</h3>
                    <p class="mrs-info-note">
                        @draft.EquipmentTypeName · уст. @draft.InstallationLabel · @draft.WorkDates
                        @if (!string.IsNullOrWhiteSpace(draft.ModelName))
                        {
                            <text> · модель @draft.ModelName</text>
                        }
                    </p>
                    <p class="mrs-info-note">Объект: @draft.ObjectAddress</p>
                    @if (!string.IsNullOrWhiteSpace(draft.EquipmentStateDisplay))
                    {
                        <p class="mrs-info-note">Состояние: @draft.EquipmentStateDisplay</p>
                    }
                    <p class="mrs-label">Перечень работ</p>
                    <ul class="mrs-act-works">
                        @foreach (var line in draft.WorkLines.Take(8))
                        {
                            <li><span class="mrs-act-mark">@line.Mark</span> @line.Label</li>
                        }
                        @if (draft.WorkLines.Count > 8)
                        {
                            <li class="mrs-info-note">… ещё @(draft.WorkLines.Count - 8)</li>
                        }
                    </ul>
                    <div class="mrs-field">
                        <label class="mrs-label">Дополнительные работы</label>
                        <textarea class="mrs-select" rows="3" @bind="draft.ExtraWorksText" @bind:event="oninput"></textarea>
                    </div>
                    <div class="mrs-field">
                        <label class="mrs-label">Замечания и рекомендации</label>
                        <textarea class="mrs-select" rows="3" @bind="draft.RemarksText" @bind:event="oninput"></textarea>
                    </div>
                    <button type="button" class="mrs-btn-secondary" disabled="@_exporting" @onclick="() => AskDownloadFormat(draft)">
                        Скачать этот акт
                    </button>
                </div>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_downloadNote))
        {
            <p class="mrs-info-note">@_downloadNote</p>
        }
    </section>
}
}

@if (_formatDraft is not null)
{
    <div class="mrs-modal-backdrop" @onclick="CancelFormatPicker">
        <div class="mrs-modal" @onclick:stopPropagation="true" style="max-width: 420px">
            <button type="button" class="mrs-modal-close" aria-label="Закрыть" @onclick="CancelFormatPicker">×</button>
            <h3 class="mrs-modal-title">Как скачать акт?</h3>
            <p class="mrs-modal-body">Выберите формат файла.</p>
            <div class="mrs-form-actions" style="margin-top: 0; flex-direction: column; align-items: stretch;">
                <button type="button" class="mrs-btn-primary" disabled="@_exporting" @onclick="() => DownloadDraftAsync(_formatDraft, ActExportFormat.Doc)">
                    Word (.doc)
                </button>
                <button type="button" class="mrs-btn-secondary" disabled="@_exporting" @onclick="() => DownloadDraftAsync(_formatDraft, ActExportFormat.Pdf)">
                    PDF (.pdf)
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ChecklistManagementRow> _rows = [];
    private List<ChecklistManagementRow> _filteredRows = [];
    private readonly HashSet<int> _selectedIds = [];
    private IReadOnlyList<InstallationFilterItem> _installationCatalog = [];
    private List<string> _objectOptions = [];
    private List<string> _installationOptions = [];
    private string _objectFilter = "all";
    private string _installationFilter = "all";

    private bool _wantInstallationAct = true;
    private bool _wantUnitActs;

    private bool _busy;
    private bool _building;
    private bool _exporting;
    private string? _error;
    private string? _downloadNote;
    private ActDraft? _formatDraft;

    private void DismissError() => _error = null;

    private enum ActExportFormat { Doc, Pdf }

    private ActAssemblyPreview? _preview;
    private ActDraft? _installationDraft;
    private List<ActDraft> _unitDrafts = [];

    protected override async Task OnInitializedAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _rows = (await ChecklistManagement.GetAllAsync().ConfigureAwait(false)).ToList();
            var facilityNames = await FacilityHierarchy.GetAllFacilityNamesAsync().ConfigureAwait(false);
            _installationCatalog = await InstallationQuery.ListActiveForFiltersAsync().ConfigureAwait(false);

            _objectOptions = MergeDistinctNames(
                facilityNames,
                _rows.Select(r => r.FacilityName));
            RebuildInstallationOptions(preserveSelection: false);
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<ChecklistManagementRow> q = _rows;
        if (_objectFilter != "all")
            q = q.Where(r => string.Equals(r.FacilityName, _objectFilter, StringComparison.OrdinalIgnoreCase));
        if (_installationFilter != "all")
            q = q.Where(r => string.Equals(r.InstallationLabel, _installationFilter, StringComparison.OrdinalIgnoreCase));
        _filteredRows = q
            .OrderByDescending(r => r.StartedAt)
            .ThenBy(r => r.EquipmentTypeName)
            .ToList();
    }

    private void OnObjectFilterChanged(ChangeEventArgs e)
    {
        _objectFilter = e.Value?.ToString() ?? "all";
        RebuildInstallationOptions(preserveSelection: true);
        ApplyFilters();
    }

    private void OnInstallationFilterChanged(ChangeEventArgs e)
    {
        _installationFilter = e.Value?.ToString() ?? "all";
        ApplyFilters();
    }

    private void RebuildInstallationOptions(bool preserveSelection)
    {
        IEnumerable<string> fromCatalog = _objectFilter == "all"
            ? _installationCatalog.Select(i => i.Label)
            : _installationCatalog
                .Where(i => string.Equals(i.FacilityName, _objectFilter, StringComparison.OrdinalIgnoreCase))
                .Select(i => i.Label);

        IEnumerable<string> fromRows = _objectFilter == "all"
            ? _rows.Select(r => r.InstallationLabel)
            : _rows
                .Where(r => string.Equals(r.FacilityName, _objectFilter, StringComparison.OrdinalIgnoreCase))
                .Select(r => r.InstallationLabel);

        _installationOptions = MergeDistinctNames(fromCatalog, fromRows);

        if (!preserveSelection
            || (_installationFilter != "all"
                && !_installationOptions.Contains(_installationFilter, StringComparer.OrdinalIgnoreCase)))
        {
            _installationFilter = "all";
        }
    }

    private static List<string> MergeDistinctNames(IEnumerable<string> primary, IEnumerable<string> extra)
    {
        var byKey = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var raw in primary.Concat(extra))
        {
            var name = (raw ?? string.Empty).Trim();
            if (name.Length == 0)
                continue;
            byKey.TryAdd(name, name);
        }

        return byKey.Values.OrderBy(v => v, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    private void ToggleSelected(int checklistId, ChangeEventArgs e)
    {
        var on = e.Value is bool b && b
                 || string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase)
                 || string.Equals(e.Value?.ToString(), "on", StringComparison.OrdinalIgnoreCase);
        if (on)
            _selectedIds.Add(checklistId);
        else
            _selectedIds.Remove(checklistId);
    }

    private void SelectAllFiltered()
    {
        foreach (var row in _filteredRows)
            _selectedIds.Add(row.ChecklistId);
        StateHasChanged();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
        StateHasChanged();
    }

    private async Task BuildDraftsAsync()
    {
        _building = true;
        _error = null;
        _downloadNote = null;
        _preview = null;
        _installationDraft = null;
        _unitDrafts = [];
        try
        {
            var ids = _selectedIds.Where(id => id < 9000).ToList();
            if (ids.Count == 0)
            {
                _error = "Отметьте контрольные листы в списке выше.";
                return;
            }

            _preview = await ActAssembly.BuildPreviewAsync(ids).ConfigureAwait(false);
            _installationDraft = _preview.InstallationAct;
            _unitDrafts = _preview.UnitActs.ToList();

            var hasNarrative = (_installationDraft?.ExtraWorksText.Length ?? 0) > 0
                || (_installationDraft?.RemarksText.Length ?? 0) > 0
                || _unitDrafts.Any(d => d.ExtraWorksText.Length > 0 || d.RemarksText.Length > 0);
            if (!hasNarrative)
            {
                _downloadNote =
                    "Перечень собран, но в выбранных КЛ пустые «Доп. работы» / «Замечания».";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _building = false;
        }
    }

    private void AskDownloadFormat(ActDraft draft) => _formatDraft = draft;

    private void CancelFormatPicker() => _formatDraft = null;

    private async Task DownloadDraftAsync(ActDraft draft, ActExportFormat format)
    {
        _exporting = true;
        _error = null;
        _downloadNote = null;
        try
        {
            var file = format == ActExportFormat.Pdf
                ? ActAssembly.RenderDraftPdf(draft)
                : ActAssembly.RenderDraftDoc(draft);
            var path = await FileSave.SaveAsync(file.FileName, file.Content);
            _formatDraft = null;
            var isWindows = DeviceInfo.Current.Platform == DevicePlatform.WinUI;
            _downloadNote = path is null
                ? "Сохранение отменено."
                : isWindows
                    ? $"Сохранено в «Загрузки»: {Path.GetFileName(path)}"
                    : "Открыто меню «Поделиться» — сохраните файл в Загрузки / Диск / Telegram.";
        }
        catch (Exception ex)
        {
            _error = $"Не удалось сохранить акт: {ex.Message}";
        }
        finally
        {
            _exporting = false;
        }
    }

    private static string FormatRowTitle(ChecklistManagementRow row)
    {
        var d = MrsDateFormat.FormatDateShort(row.StartedAt);
        return $"{d} · {row.MaintenanceTypeName} · #{row.ChecklistId}";
    }
}
