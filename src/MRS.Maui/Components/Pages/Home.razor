@page "/"
@using MRS.Application.Admin
@using MRS.Application.Security
@using MRS.Application.Storage
@using MRS.Application.Users
@implements IDisposable
@inject ILocalDatabasePath DatabasePath
@inject ILocalDatabaseBootstrapper DatabaseBootstrapper
@inject ICurrentUserSession Session
@inject IAdminSupportRequestService SupportRequests
@inject IEngineerDirectoryService Engineers

<PageTitle>Главная</PageTitle>

<div class="mrs-home">
    <div class="mrs-home-panel">
        <a class="mrs-home-btn" href="checklists">Заполнить КЛ</a>
        <a class="mrs-home-btn" href="checklists/acts">Собрать акт</a>
        <a class="mrs-home-btn" href="management">Управление КЛ</a>
        <a class="mrs-home-btn" href="objects">Организации и планирование</a>
        @if (Session.IsDbAdministrator)
        {
            <a class="mrs-home-btn" href="admin/colleagues">Коллеги</a>
            <a class="mrs-home-btn" href="sql">
                SQL-окно
                @if (_openSupportCount > 0)
                {
                    <span class="mrs-home-badge">@_openSupportCount</span>
                }
            </a>
        }
    </div>

    @if (Session.IsEngineer)
    {
        <div class="mrs-home-engineer">
            <label class="mrs-label mrs-home-engineer-label" for="engineer-name">Кто вы (для обращений администратору)</label>
            <div class="mrs-home-engineer-row">
                <select id="engineer-name" class="mrs-select" @bind="_selectedEngineerId" @bind:after="OnEngineerPickedAsync" disabled="@_busy">
                    <option value="0">— выберите из справочника —</option>
                    @foreach (var e in _engineers)
                    {
                        <option value="@e.UserId">@e.DisplayName</option>
                    }
                </select>
            </div>
            @if (_engineers.Count == 0)
            {
                <p class="mrs-home-note">Справочник пуст. Администратор может добавить коллег через «Коллеги».</p>
            }
            else if (_engineerNameSaved)
            {
                <p class="mrs-save-msg mrs-home-note">Выбрано: будет подставляться в обращения автоматически.</p>
            }
        </div>
    }

    <div class="mrs-home-role">
        <span>Роль: <strong>@Session.Current.RoleName</strong></span>
        <button type="button" class="mrs-home-role-switch" @onclick="ToggleRole">
            @(Session.IsEngineer ? "Войти как администратор БД" : "Войти как инженер")
        </button>
    </div>

    @if (_status is not null && !_status.Ready)
    {
        <p class="text-danger mrs-home-note">Ошибка БД: @_status.Error</p>
    }
</div>

@code {
    private LocalDatabaseStatus? _status;
    private readonly List<EngineerDirectoryEntry> _engineers = [];
    private int _selectedEngineerId;
    private bool _engineerNameSaved;
    private bool _busy;
    private int _openSupportCount;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        var path = DatabasePath.GetDatabaseFilePath();
        _status = await DatabaseBootstrapper.EnsureReadyAsync(path);
        await RefreshSessionUiAsync();
    }

    private async Task RefreshSessionUiAsync()
    {
        _busy = true;
        try
        {
            _engineerNameSaved = false;
            _engineers.Clear();
            if (Session.IsEngineer)
            {
                var list = await Engineers.ListActiveAsync().ConfigureAwait(false);
                _engineers.AddRange(list);
                var match = _engineers.FirstOrDefault(e =>
                    string.Equals(e.DisplayName, Session.Current.DisplayName, StringComparison.OrdinalIgnoreCase));
                _selectedEngineerId = match?.UserId ?? 0;
            }

            _openSupportCount = Session.IsDbAdministrator
                ? await SupportRequests.CountOpenAsync().ConfigureAwait(false)
                : 0;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnEngineerPickedAsync()
    {
        if (_selectedEngineerId <= 0)
            return;

        var entry = _engineers.FirstOrDefault(e => e.UserId == _selectedEngineerId);
        if (entry is null)
            return;

        try
        {
            await Session.SetEngineerDisplayNameAsync(entry.DisplayName).ConfigureAwait(false);
            _engineerNameSaved = true;
        }
        catch (Exception ex)
        {
            _engineerNameSaved = false;
            _status = new LocalDatabaseStatus(false, 0, 0, 0, ex.Message);
        }
    }

    private async Task ToggleRole()
    {
        var next = Session.IsEngineer ? UserRoleNames.DbAdministrator : UserRoleNames.Engineer;
        await Session.SetRoleAsync(next);
        await RefreshSessionUiAsync();
    }

    private async void OnSessionChanged() => await InvokeAsync(async () =>
    {
        await RefreshSessionUiAsync();
        StateHasChanged();
    });

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
