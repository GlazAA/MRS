@page "/checklists/create"
@using System.Globalization
@using MRS.Application.Checklists
@using MRS.Application.Facilities
@implements IAsyncDisposable
@inject IEquipmentTypeCatalogService EquipmentCatalog
@inject IChecklistFlowService Flow
@inject IChecklistEditService ChecklistEdit
@inject IInstallationQueryService InstallationQuery
@inject IInstallationEnsureService InstallationEnsure
@inject IEquipmentModelCatalogService ModelCatalog
@inject NavigationManager Nav

<PageTitle>Создание контрольного листа</PageTitle>

<div class="mrs-toolbar">
    <button type="button" class="mrs-back" @onclick="NavigateBackAsync">←</button>
    <h1 class="mrs-title">@(_existingChecklistId is null ? "Создание контрольного листа" : "Контрольный лист")</h1>
    <MrsTopMenu />
</div>

@if (OrganizationId is null || FacilityId is null || SystemId is null || EquipmentTypeId is null || MaintenanceTypeId is null)
{
    <p>Не хватает параметров (нужен также <strong>maintenanceTypeId</strong>). <a href="checklists">На начало</a></p>
}
else if (_error is not null)
{
    <p class="text-danger">@_error</p>
}
else if (_busy)
{
    <p>Загрузка шаблона…</p>
}
else if (_templateId is null)
{
    <p class="text-danger">Не найден шаблон для выбранной пары «тип оборудования — вид ТО».</p>
    <p><a href="@BackLink">Назад</a></p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(_meta?.TopPlateText))
    {
        <div class="mrs-top-plate mrs-pre-wrap">@_meta!.TopPlateText</div>
    }

    @if (_pageWorkStartedAt is not null || _sessionStartedAt is not null)
    {
        <p class="mrs-info-note">Затраченное время: <strong>@_elapsedDisplay</strong></p>
    }

    <div class="mrs-field">
        <label class="mrs-label">Установка *</label>
        <p class="mrs-hint">Выберите существующую или создайте по номеру (например G301).</p>
        <select class="mrs-select" value="@_installationChoice" @onchange="OnInstallationSelectAsync" disabled="@_installationLocked">
            <option value="">—</option>
            @foreach (var ins in _installations)
            {
                <option value="@ins.Id.ToString(CultureInfo.InvariantCulture)">@ins.Label</option>
            }
            <option value="new">Новая установка (ввести номер)…</option>
        </select>
        @if (_installationChoice == "new")
        {
            <input type="text"
                   class="mrs-select mrs-mt"
                   placeholder="Номер установки (например G301)"
                   @bind="_newUnitNumber"
                   @bind:event="oninput"
                   @onblur="OnNewUnitNumberBlurAsync"
                   disabled="@_installationLocked" />
            <p class="mrs-field-hint">Номер зафиксируется, когда уйдёте из поля (не по первой цифре).</p>
        }
    </div>

    @foreach (var field in VisibleFields)
    {
        var ft = field.FieldTypeName.ToLowerInvariant();
        <div class="mrs-field">
            <label class="mrs-label">@field.QuestionText@if (field.IsRequired) { <text> *</text> }</label>
            @if (!string.IsNullOrWhiteSpace(field.HintText))
            {
                <p class="mrs-hint">@field.HintText</p>
            }
            @if (EquipmentModelFieldCodes.IsManufacturerField(field.FieldCode))
            {
                <p class="mrs-field-hint">Начните вводить — выберите из списка или оставьте новое значение (необязательно).</p>
                <EquipmentCatalogCombobox Value="@GetValue(field.TemplateItemId)"
                                          ValueChanged="@(v => OnManufacturerValueAsync(field, v))"
                                          Options="@GetManufacturersForField(field.FieldCode)"
                                          Placeholder="Производитель…" />
            }
            else if (EquipmentModelFieldCodes.IsModelField(field.FieldCode))
            {
                var selectedMfg = GetSelectedManufacturerForModelField(field);
                <p class="mrs-field-hint">Сначала производитель, затем модель — из списка или новая (необязательно).</p>
                <EquipmentCatalogCombobox Value="@GetValue(field.TemplateItemId)"
                                          ValueChanged="@(v => SetValue(field.TemplateItemId, v))"
                                          Options="@GetCachedModelNames(field.FieldCode, selectedMfg)"
                                          Disabled="@(string.IsNullOrWhiteSpace(selectedMfg))"
                                          Placeholder="Модель…" />
            }
            else
            {
            @switch (ft)
            {
                case "textarea":
                    <textarea class="mrs-select" rows="4" value="@GetValue(field.TemplateItemId)" @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))"></textarea>
                    break;
                case "date":
                    <input type="date" class="mrs-select" value="@GetValue(field.TemplateItemId)" @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                    break;
                case "time":
                    <input type="time" class="mrs-select" value="@GetValue(field.TemplateItemId)" @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                    break;
                case "number":
                    <input type="number" class="mrs-select" value="@GetValue(field.TemplateItemId)" @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                    break;
                case "boolean":
                    <select class="mrs-select" value="@GetValue(field.TemplateItemId)" @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))">
                        <option value="">—</option>
                        <option value="false">Нет</option>
                        <option value="true">Да</option>
                    </select>
                    break;
                case "dropdown_multiple":
                case "checkbox":
                    <MultiSelectSearchPicker TemplateItemId="field.TemplateItemId"
                                             Options="field.Options"
                                             Value="@GetValue(field.TemplateItemId)"
                                             ValueChanged="@(v => SetValue(field.TemplateItemId, v))"
                                             AllowCreateEngineer="ChecklistFieldCodes.IsWorkers(field.FieldCode)"
                                             Placeholder="@(ChecklistFieldCodes.IsWorkers(field.FieldCode) ? "ФИО или фрагмент…" : "Поиск…")" />
                    break;
                case "radio":
                case "dropdown":
                    @if (field.Options.Count > 0)
                    {
                        <select class="mrs-select" value="@GetValue(field.TemplateItemId)" @onchange="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))">
                            <option value="">—</option>
                            @foreach (var opt in field.Options)
                            {
                                <option value="@opt.OptionId.ToString(CultureInfo.InvariantCulture)">@opt.Label</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="mrs-select" value="@GetValue(field.TemplateItemId)" @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                    }
                    break;
                default:
                    <input type="text" class="mrs-select" value="@GetValue(field.TemplateItemId)" @oninput="@(e => SetValue(field.TemplateItemId, e.Value?.ToString()))" />
                    break;
            }
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_saveMessage))
    {
        <p class="mrs-save-msg">@_saveMessage</p>
    }

    <div class="mrs-form-actions">
        <button type="button" class="mrs-btn-secondary" disabled="@_saving" @onclick="@(() => SaveAsync(ChecklistPersistenceMode.LocalDraft))">Сохранить локально</button>
        <button type="button" class="mrs-btn-primary" disabled="@_saving" @onclick="@(() => SaveAsync(ChecklistPersistenceMode.UploadQueue))">Сохранить в БД</button>
    </div>
    <p class="mrs-info-note">«Сохранить локально» — сохраняет ответы и ставит учёт времени на паузу (лист «В работе»). «Сохранить в БД» — завершает лист и фиксирует затраченное время.</p>
}

@if (_meta?.RedButtonEnabled == true && !string.IsNullOrWhiteSpace(_meta.SafetyModalText))
{
    <button type="button" class="mrs-safety-fab" aria-label="Инструкция по безопасности" @onclick="() => _showSafety = true"></button>
}

@if (_showSafety && !string.IsNullOrWhiteSpace(_meta?.SafetyModalText))
{
    <div class="mrs-modal-backdrop" @onclick="() => _showSafety = false">
        <div class="mrs-modal" @onclick:stopPropagation="true">
            <button type="button" class="mrs-modal-close" aria-label="Закрыть" @onclick="() => _showSafety = false">×</button>
            <h3 class="mrs-modal-title">Безопасность</h3>
            <p class="mrs-modal-body mrs-pre-wrap">@_meta!.SafetyModalText</p>
        </div>
    </div>
}

@code {
	[SupplyParameterFromQuery] public int? OrganizationId { get; set; }
	[SupplyParameterFromQuery] public int? FacilityId { get; set; }
	[SupplyParameterFromQuery] public int? SystemId { get; set; }
	[SupplyParameterFromQuery] public int? EquipmentTypeId { get; set; }
	[SupplyParameterFromQuery] public int? MaintenanceTypeId { get; set; }
	[SupplyParameterFromQuery] public int? ChecklistId { get; set; }

	private readonly Dictionary<int, string> _values = [];
	private List<TemplateFieldDefinition> _fields = [];
	private List<InstallationListItem> _installations = [];
	private ChecklistTemplateMeta? _meta;
	private int? _templateId;
	private int? _existingChecklistId;
	private bool _installationLocked;
	private string? _error;
	private string? _saveMessage;
	private bool _busy;
	private bool _saving;
	private bool _showSafety;
	private bool _skipPauseOnDispose;
	private string _installationChoice = "";
	private string _newUnitNumber = "";
	private DateTimeOffset? _pageWorkStartedAt;
	private DateTimeOffset? _sessionStartedAt;
	private Timer? _elapsedTimer;
	private string _elapsedDisplay = "0:00:00";
	private string? _loadedContextKey;
	private IDisposable? _locationChangingRegistration;
	private readonly Dictionary<int, List<string>> _manufacturersByEquipmentType = [];
	private readonly Dictionary<string, List<string>> _modelsByKey = new(StringComparer.OrdinalIgnoreCase);

	private IEnumerable<TemplateFieldDefinition> VisibleFields =>
		_fields.Where(f => !ChecklistFieldCodes.IsHiddenOnFillForm(f.FieldCode));

	private string BackLink =>
		OrganizationId is int o && FacilityId is int f && SystemId is int s && EquipmentTypeId is int e
			? $"/checklists/maintenance?organizationId={o}&facilityId={f}&systemId={s}&equipmentTypeId={e}"
			: "checklists";

	private string BuildContextKey() =>
		$"{OrganizationId}|{FacilityId}|{SystemId}|{EquipmentTypeId}|{MaintenanceTypeId}|{ChecklistId}";

	protected override void OnInitialized()
	{
		_locationChangingRegistration = Nav.RegisterLocationChangingHandler(OnLocationChangingAsync);
	}

	private async ValueTask OnLocationChangingAsync(LocationChangingContext context)
	{
		if (_skipPauseOnDispose)
			return;

		if (string.Equals(Nav.Uri, context.TargetLocation, StringComparison.OrdinalIgnoreCase))
			return;

		await PauseWorkSessionAsync().ConfigureAwait(false);
	}

	protected override async Task OnParametersSetAsync()
	{
		var contextKey = BuildContextKey();
		if (contextKey == _loadedContextKey && _templateId is not null)
			return;

		_loadedContextKey = contextKey;
		await LoadPageAsync().ConfigureAwait(false);
	}

	private async Task LoadPageAsync()
	{
		_error = null;
		_saveMessage = null;
		_meta = null;
		_fields = [];
		_installations = [];
		_templateId = null;
		_existingChecklistId = null;
		_installationLocked = false;
		_showSafety = false;
		_skipPauseOnDispose = false;
		_pageWorkStartedAt = null;
		_sessionStartedAt = null;
		_elapsedDisplay = "0:00:00";
		StopElapsedTimer();
		_installationChoice = "";
		_newUnitNumber = "";
		_values.Clear();

		if (SystemId is not int sid || EquipmentTypeId is not int etid || MaintenanceTypeId is not int mtid)
			return;

		_busy = true;
		try
		{
			var types = await EquipmentCatalog.GetForSystemAsync(sid).ConfigureAwait(false);
			if (types.All(t => t.Id != etid))
			{
				_error = "Тип оборудования не относится к выбранной системе.";
				return;
			}

			_installations = (await InstallationQuery.GetForSystemAndEquipmentAsync(sid, etid).ConfigureAwait(false)).ToList();

			_templateId = await Flow.ResolveTemplateIdAsync(etid, mtid, FacilityId).ConfigureAwait(false);
			if (_templateId is not int tid)
				return;

			_meta = await Flow.GetTemplateMetaAsync(tid).ConfigureAwait(false);
			_fields = (await Flow.GetTemplateFieldsAsync(tid).ConfigureAwait(false)).ToList();
			await LoadCatalogsForTemplateAsync(etid).ConfigureAwait(false);
			foreach (var f in _fields)
				_values.TryAdd(f.TemplateItemId, string.Empty);

			if (ChecklistId is int resumeId)
			{
				var editModel = await ChecklistEdit.GetForEditAsync(resumeId).ConfigureAwait(false);
				if (editModel.Info.StatusCode != "in_progress")
				{
					_error = "Этот контрольный лист завершён и доступен только для просмотра.";
					return;
				}

				if (editModel.Info.EndedAt is not null)
					await ChecklistEdit.ResumeWorkAsync(resumeId).ConfigureAwait(false);

				editModel = await ChecklistEdit.GetForEditAsync(resumeId).ConfigureAwait(false);

				_existingChecklistId = resumeId;
				_installationLocked = true;
				_pageWorkStartedAt = editModel.Info.StartedAt ?? DateTimeOffset.Now;
				_sessionStartedAt = editModel.Info.StartedAt;
				_installationChoice = editModel.Info.InstallationId.ToString(CultureInfo.InvariantCulture);
				foreach (var field in editModel.Fields)
					_values[field.TemplateItemId] = field.ValueRaw;

				await PrefetchModelOptionsAsync().ConfigureAwait(false);
				StartElapsedTimer();
			}
			else
			{
				_pageWorkStartedAt = DateTimeOffset.Now;
				StartElapsedTimer();
			}
		}
		catch (Exception ex)
		{
			_error = ex.Message;
		}
		finally
		{
			_busy = false;
		}
	}

	private async Task OnInstallationSelectAsync(ChangeEventArgs e)
	{
		_installationChoice = e.Value?.ToString() ?? "";
		if (_installationChoice != "new")
			_newUnitNumber = "";

		// Для «новой» установки ждём blur по полю номера — иначе «301» успевает сохраниться как «3».
		if (_installationChoice == "new")
			return;

		await BindInstallationToSessionAsync().ConfigureAwait(false);

		if (int.TryParse(_installationChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var installationId))
			await ApplyInstallationModelPrefillAsync(installationId).ConfigureAwait(false);
	}

	private async Task OnNewUnitNumberBlurAsync()
	{
		if (_installationChoice != "new" || string.IsNullOrWhiteSpace(_newUnitNumber))
			return;

		await BindInstallationToSessionAsync().ConfigureAwait(false);
		await RefreshInstallationsListAsync().ConfigureAwait(false);
	}

	/// <summary>
	/// Привязывает выбранную/введённую установку к черновику КЛ.
	/// Если лист уже создан — обновляет installation_id (не оставляет первую цифру номера).
	/// </summary>
	private async Task BindInstallationToSessionAsync()
	{
		var installationId = await ResolveInstallationIdAsync().ConfigureAwait(false);
		if (installationId is null)
			return;

		SyncUnitNumberAnswerFromInstallation();

		if (_existingChecklistId is int cid)
		{
			await ChecklistEdit.SetInstallationAsync(cid, installationId.Value).ConfigureAwait(false);
			return;
		}

		await TryEnsureWorkSessionAsync().ConfigureAwait(false);
	}

	/// <summary>
	/// Пишет номер из блока «Установка» в ответ unit_number (поле шаблона скрыто, но остаётся в БД для экспорта/синка).
	/// </summary>
	private void SyncUnitNumberAnswerFromInstallation()
	{
		var field = _fields.FirstOrDefault(f => ChecklistFieldCodes.IsUnitNumber(f.FieldCode));
		if (field is null)
			return;

		var label = ResolveSelectedInstallationLabel();
		if (string.IsNullOrWhiteSpace(label))
			return;

		SetValue(field.TemplateItemId, label);
	}

	private string? ResolveSelectedInstallationLabel()
	{
		if (_installationChoice == "new")
			return string.IsNullOrWhiteSpace(_newUnitNumber) ? null : _newUnitNumber.Trim();

		if (!int.TryParse(_installationChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var installationId))
			return null;

		return _installations.FirstOrDefault(i => i.Id == installationId)?.Label;
	}

	private async Task RefreshInstallationsListAsync()
	{
		if (SystemId is not int sid || EquipmentTypeId is not int etid)
			return;

		_installations = (await InstallationQuery.GetForSystemAndEquipmentAsync(sid, etid).ConfigureAwait(false)).ToList();
	}

	private void StartElapsedTimer()
	{
		StopElapsedTimer();
		RecalcElapsedDisplay();
		_elapsedTimer = new Timer(_ =>
		{
			_ = InvokeAsync(() =>
			{
				RecalcElapsedDisplay();
				StateHasChanged();
				return Task.CompletedTask;
			});
		}, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
	}

	private void StopElapsedTimer()
	{
		_elapsedTimer?.Dispose();
		_elapsedTimer = null;
	}

	private void RecalcElapsedDisplay()
	{
		var start = _sessionStartedAt ?? _pageWorkStartedAt;
		if (start is null)
		{
			_elapsedDisplay = "—";
			return;
		}

		_elapsedDisplay = ChecklistDurationFormatter.FormatActive(start);
	}

	private async Task PauseWorkSessionAsync()
	{
		if (_templateId is null)
			return;

		if (_existingChecklistId is int existingId)
		{
			await ChecklistEdit.PauseWorkAsync(existingId).ConfigureAwait(false);
			return;
		}

		var installationId = await ResolveInstallationIdAsync().ConfigureAwait(false);
		if (installationId is null || _templateId is not int tid || MaintenanceTypeId is not int mtId)
			return;

		var startedAt = _pageWorkStartedAt ?? DateTimeOffset.Now;
		var checklistId = await ChecklistEdit.BeginInProgressAsync(new BeginInProgressChecklistRequest(
			installationId.Value,
			tid,
			mtId,
			1,
			startedAt)).ConfigureAwait(false);
		_existingChecklistId = checklistId;
		await ChecklistEdit.PauseWorkAsync(checklistId).ConfigureAwait(false);
	}

	private async Task NavigateBackAsync()
	{
		await PauseWorkSessionAsync().ConfigureAwait(false);
		_skipPauseOnDispose = true;
		Nav.NavigateTo(BackLink);
	}

	private async Task TryEnsureWorkSessionAsync()
	{
		if (_existingChecklistId is not null || _templateId is not int tid || MaintenanceTypeId is not int mtId)
			return;

		var installationId = await ResolveInstallationIdAsync().ConfigureAwait(false);
		if (installationId is null)
			return;

		var startedAt = _pageWorkStartedAt ?? DateTimeOffset.Now;
		var checklistId = await ChecklistEdit.BeginInProgressAsync(new BeginInProgressChecklistRequest(
			installationId.Value,
			tid,
			mtId,
			1,
			startedAt)).ConfigureAwait(false);

		var editModel = await ChecklistEdit.GetForEditAsync(checklistId).ConfigureAwait(false);
		_existingChecklistId = checklistId;
		_sessionStartedAt = editModel.Info.StartedAt ?? startedAt;
		RecalcElapsedDisplay();
	}

	private async Task<int?> ResolveInstallationIdAsync()
	{
		if (SystemId is not int sysId || EquipmentTypeId is not int etId)
			return null;

		if (string.IsNullOrEmpty(_installationChoice))
			return null;

		if (_installationChoice == "new")
		{
			if (string.IsNullOrWhiteSpace(_newUnitNumber))
				return null;

			try
			{
				return await InstallationEnsure.EnsureAsync(sysId, etId, _newUnitNumber).ConfigureAwait(false);
			}
			catch
			{
				return null;
			}
		}

		return int.TryParse(_installationChoice, NumberStyles.Integer, CultureInfo.InvariantCulture, out var installationId)
			? installationId
			: null;
	}

	private string GetValue(int itemId) =>
		_values.TryGetValue(itemId, out var v) ? v : string.Empty;

	private void SetValue(int itemId, string? value)
	{
		_values[itemId] = value ?? string.Empty;
	}

	private async Task SaveAsync(ChecklistPersistenceMode mode)
	{
		_saveMessage = null;
		if (_templateId is not int tid || SystemId is not int sysId || EquipmentTypeId is not int etId
		    || MaintenanceTypeId is not int mtId || OrganizationId is not int orgId || FacilityId is not int facId)
		{
			_saveMessage = "Не хватает контекста для сохранения.";
			return;
		}

		if (string.IsNullOrEmpty(_installationChoice))
		{
			_saveMessage = "Выберите установку или создайте новую по номеру.";
			return;
		}

		var installationId = await ResolveInstallationIdAsync().ConfigureAwait(false);
		if (installationId is null)
		{
			_saveMessage = _installationChoice == "new"
				? "Укажите номер или название установки."
				: "Некорректный выбор установки.";
			return;
		}

		SyncUnitNumberAnswerFromInstallation();

		if (_existingChecklistId is int existingId)
		{
			// Номер мог уточниться после старта сессии — перепривязываем установку перед сохранением.
			await ChecklistEdit.SetInstallationAsync(existingId, installationId.Value).ConfigureAwait(false);
		}
		else
		{
			try
			{
				var startedAt = _pageWorkStartedAt ?? DateTimeOffset.Now;
				var checklistId = await ChecklistEdit.BeginInProgressAsync(new BeginInProgressChecklistRequest(
					installationId.Value,
					tid,
					mtId,
					1,
					startedAt)).ConfigureAwait(false);
				_existingChecklistId = checklistId;
				_sessionStartedAt = startedAt;
			}
			catch (Exception ex)
			{
				_saveMessage = ex.Message;
				return;
			}
		}

		await SaveExistingAsync(_existingChecklistId.Value, orgId, facId, sysId, mode).ConfigureAwait(false);
	}

	private async Task SaveExistingAsync(int checklistId, int orgId, int facId, int sysId, ChecklistPersistenceMode mode)
	{
		_saving = true;
		try
		{
			if (mode == ChecklistPersistenceMode.UploadQueue)
			EnsureEndDateForUploadQueue();

			await PersistCatalogEntriesAsync().ConfigureAwait(false);

			var fieldIds = _fields.Select(f => f.TemplateItemId).ToList();
			var request = new UpdateChecklistAnswersRequest(checklistId, _values);
			var apply = await ChecklistEdit.ApplyAsync(request, fieldIds).ConfigureAwait(false);
			if (!apply.Ok)
			{
				_saveMessage = apply.ErrorMessage ?? "Ошибка сохранения.";
				return;
			}

			if (mode == ChecklistPersistenceMode.UploadQueue)
				await ChecklistEdit.CompleteWorkAsync(checklistId).ConfigureAwait(false);
			else
				await ChecklistEdit.PauseWorkAsync(checklistId).ConfigureAwait(false);

			_skipPauseOnDispose = true;
			Nav.NavigateTo($"/checklists?organizationId={orgId}&facilityId={facId}&systemId={sysId}", forceLoad: true);
		}
		finally
		{
			_saving = false;
		}
	}

	private void EnsureEndDateForUploadQueue()
	{
		var endDateField = _fields.FirstOrDefault(f =>
			f.FieldCode is not null &&
			f.FieldCode.Equals(ChecklistFieldCodes.EndDate, StringComparison.OrdinalIgnoreCase));
		if (endDateField is null)
			return;

		if (!string.IsNullOrWhiteSpace(GetValue(endDateField.TemplateItemId)))
			return;

		SetValue(endDateField.TemplateItemId, MoscowRegionalClock.TodayIsoDate);
	}

	private async Task LoadCatalogsForTemplateAsync(int installationEquipmentTypeId)
	{
		_manufacturersByEquipmentType.Clear();
		_modelsByKey.Clear();

		var typeIds = _fields
			.Where(f => EquipmentModelFieldCodes.IsManufacturerField(f.FieldCode) || EquipmentModelFieldCodes.IsModelField(f.FieldCode))
			.Select(f => EquipmentModelFieldCodes.ResolveCatalogEquipmentTypeId(f.FieldCode, installationEquipmentTypeId))
			.Append(installationEquipmentTypeId)
			.Distinct()
			.ToList();

		foreach (var etId in typeIds)
		{
			_manufacturersByEquipmentType[etId] =
				(await ModelCatalog.GetManufacturersAsync(etId).ConfigureAwait(false)).ToList();
		}
	}

	private int ResolveFieldEquipmentTypeId(string? fieldCode)
	{
		var fallback = EquipmentTypeId ?? 0;
		return EquipmentModelFieldCodes.ResolveCatalogEquipmentTypeId(fieldCode, fallback);
	}

	private IReadOnlyList<string> GetManufacturersForField(string? fieldCode)
	{
		var etId = ResolveFieldEquipmentTypeId(fieldCode);
		return _manufacturersByEquipmentType.TryGetValue(etId, out var list) ? list : [];
	}

	private async Task PrefetchModelOptionsAsync()
	{
		foreach (var field in _fields.Where(f => EquipmentModelFieldCodes.IsModelField(f.FieldCode)))
		{
			var manufacturer = GetSelectedManufacturerForModelField(field);
			if (!string.IsNullOrWhiteSpace(manufacturer))
				await EnsureModelsCachedAsync(field.FieldCode, manufacturer).ConfigureAwait(false);
		}
	}

	private async Task EnsureModelsCachedAsync(string? fieldCode, string manufacturer)
	{
		var etId = ResolveFieldEquipmentTypeId(fieldCode);
		var key = CacheKey(etId, manufacturer);
		if (key.Length == 0 || _modelsByKey.ContainsKey(key))
			return;

		var models = (await ModelCatalog.GetModelsAsync(etId, manufacturer).ConfigureAwait(false)).ToList();
		_modelsByKey[key] = models.Select(m => m.Name).ToList();
	}

	private IReadOnlyList<string> GetCachedModelNames(string? fieldCode, string? manufacturer)
	{
		if (string.IsNullOrWhiteSpace(manufacturer))
			return [];

		var etId = ResolveFieldEquipmentTypeId(fieldCode);
		var key = CacheKey(etId, manufacturer);
		return _modelsByKey.TryGetValue(key, out var models) ? models : [];
	}

	private static string CacheKey(int equipmentTypeId, string manufacturer) =>
		equipmentTypeId + "|" + manufacturer.Trim().ToLowerInvariant();

	private string? GetSelectedManufacturerForModelField(TemplateFieldDefinition modelField)
	{
		var manufacturerCode = EquipmentModelFieldCodes.GetManufacturerFieldCode(modelField.FieldCode);
		if (manufacturerCode is null)
			return null;

		var manufacturerField = _fields.FirstOrDefault(f =>
			string.Equals(f.FieldCode, manufacturerCode, StringComparison.OrdinalIgnoreCase));
		return manufacturerField is null ? null : GetValue(manufacturerField.TemplateItemId);
	}

	private async Task OnManufacturerValueAsync(TemplateFieldDefinition field, string value)
	{
		SetValue(field.TemplateItemId, value);

		var modelCode = EquipmentModelFieldCodes.GetModelFieldCode(field.FieldCode);
		if (modelCode is not null)
		{
			var modelField = _fields.FirstOrDefault(f =>
				string.Equals(f.FieldCode, modelCode, StringComparison.OrdinalIgnoreCase));
			if (modelField is not null)
				SetValue(modelField.TemplateItemId, string.Empty);
		}

		if (!string.IsNullOrWhiteSpace(value))
			await EnsureModelsCachedAsync(field.FieldCode, value).ConfigureAwait(false);
	}

	private async Task PersistCatalogEntriesAsync()
	{
		if (EquipmentTypeId is not int fallbackEtId)
			return;

		foreach (var mfgField in _fields.Where(f => EquipmentModelFieldCodes.IsManufacturerField(f.FieldCode)))
		{
			var mfg = GetValue(mfgField.TemplateItemId)?.Trim() ?? string.Empty;
			var modelCode = EquipmentModelFieldCodes.GetModelFieldCode(mfgField.FieldCode);
			var modelField = _fields.FirstOrDefault(f =>
				string.Equals(f.FieldCode, modelCode, StringComparison.OrdinalIgnoreCase));
			var model = modelField is null ? string.Empty : (GetValue(modelField.TemplateItemId)?.Trim() ?? string.Empty);

			if (mfg.Length == 0 || model.Length == 0)
				continue;

			var etId = EquipmentModelFieldCodes.ResolveCatalogEquipmentTypeId(mfgField.FieldCode, fallbackEtId);
			try
			{
				var entry = await ModelCatalog.EnsureModelEntryAsync(etId, mfg, model).ConfigureAwait(false);
				SetValue(mfgField.TemplateItemId, entry.Manufacturer);
				if (modelField is not null)
					SetValue(modelField.TemplateItemId, entry.Name);

				if (!_manufacturersByEquipmentType.TryGetValue(etId, out var mfgs))
				{
					mfgs = [];
					_manufacturersByEquipmentType[etId] = mfgs;
				}

				if (!mfgs.Any(x => string.Equals(x, entry.Manufacturer, StringComparison.OrdinalIgnoreCase)))
					mfgs.Add(entry.Manufacturer);

				_modelsByKey[CacheKey(etId, entry.Manufacturer)] =
					(await ModelCatalog.GetModelsAsync(etId, entry.Manufacturer).ConfigureAwait(false))
					.Select(m => m.Name)
					.ToList();
			}
			catch
			{
				// Не блокируем сохранение листа из‑за справочника.
			}
		}
	}

	private async Task ApplyInstallationModelPrefillAsync(int installationId)
	{
		if (EquipmentTypeId is not int installationEtId)
			return;

		var info = await ModelCatalog.GetInstallationModelAsync(installationId).ConfigureAwait(false);
		if (info is null)
			return;

		foreach (var field in _fields.Where(f => EquipmentModelFieldCodes.IsManufacturerField(f.FieldCode)))
		{
			var fieldEtId = EquipmentModelFieldCodes.ResolveCatalogEquipmentTypeId(field.FieldCode, installationEtId);
			if (fieldEtId != installationEtId)
				continue;

			if (!string.IsNullOrWhiteSpace(info.Manufacturer))
			{
				SetValue(field.TemplateItemId, info.Manufacturer);
				await EnsureModelsCachedAsync(field.FieldCode, info.Manufacturer).ConfigureAwait(false);
			}

			var modelCode = EquipmentModelFieldCodes.GetModelFieldCode(field.FieldCode);
			var modelField = _fields.FirstOrDefault(f =>
				string.Equals(f.FieldCode, modelCode, StringComparison.OrdinalIgnoreCase));
			if (modelField is not null && !string.IsNullOrWhiteSpace(info.ModelName))
				SetValue(modelField.TemplateItemId, info.ModelName);
		}
	}

	public async ValueTask DisposeAsync()
	{
		StopElapsedTimer();
		_locationChangingRegistration?.Dispose();
		_locationChangingRegistration = null;

		if (_skipPauseOnDispose)
			return;

		try
		{
			await PauseWorkSessionAsync().ConfigureAwait(false);
		}
		catch
		{
			// Не блокируем выход при ошибке паузы.
		}
	}
}
